\begin{aligned}
0&\le\alpha\ \perp\ \lambda-F_{\alpha}\ge0,\\
0&\le\beta\ \perp\ \lambda-F_{\beta}\ge0,\\
0&\le\lambda\ \perp\ 24-\alpha-\beta\ge0.
\end{aligned}
\]
\end_inset


