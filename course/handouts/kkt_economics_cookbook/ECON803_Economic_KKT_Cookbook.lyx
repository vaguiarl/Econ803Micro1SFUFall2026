\begin_layout Section
One derivation worth knowing
\end_layout

\begin_layout Standard
Take 
\begin_inset Formula \[
\max_{x\ge0}f(x)
\;\text{subject to}\;
s(x)\ge0,
\; h(x)=0.
\]
\end_inset

Introduce 
\begin_inset Formula $\lambda\ge0$
\end_inset

 for 
\begin_inset Formula $s(x)\ge0$
\end_inset

, 
\begin_inset Formula $\mu\ge0$
\end_inset

 for 
\begin_inset Formula $x\ge0$
\end_inset

, and a free vector 
\begin_inset Formula $\nu$
\end_inset

 for 
\begin_inset Formula $h(x)=0$
\end_inset

: 
\begin_inset Formula \[
\mathcal L(x,\lambda,\nu,\mu)
=f(x)+\lambda^{\top}s(x)+\nu^{\top}h(x)+\mu^{\top}x.
\]
\end_inset

The full stationarity condition is 
\begin_inset Formula \[
\nabla f(x)+J_s(x)^{\top}\lambda+J_h(x)^{\top}\nu+\mu=0.
\]
\end_inset

Let 
\begin_inset Formula \[
D:=\nabla f(x)+J_s(x)^{\top}\lambda+J_h(x)^{\top}\nu.
\]
\end_inset

Then stationarity says 
\begin_inset Formula $\mu=-D$
\end_inset

. Since 
\begin_inset Formula $\mu\ge0$
\end_inset

 and 
\begin_inset Formula $x_i\mu_i=0$
\end_inset

, we can eliminate 
\begin_inset Formula $\mu$
\end_inset

 and write the compact system 
\begin_inset Formula \begin{equation}
\boxed{
0\le x\ \perp\ -D\ge0,
\;
0\le\lambda\ \perp\ s(x)\ge0,
\; h(x)=0.}
\label{eq:compact-kkt}
\end{equation}
\end_inset


\end_layout

