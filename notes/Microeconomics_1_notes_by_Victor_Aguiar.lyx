\begin_layout Section
The Critical Cost-Efficiency Index
\end_layout

\begin_layout Standard
When a dataset 
\begin_inset Formula $\mathcal{O}$
\end_inset

 fails GARP,
 the critical cost-efficiency index measures the size of the revealed-preference violation.
 For an efficiency level 
\begin_inset Formula $\alpha\in[0,1]$
\end_inset

,
 write the efficiency-adjusted relations as 
\begin_inset Formula $\notationfirst{efficiency-relations}{\succeq^{R,D}_{\alpha},\succ^{R,D}_{\alpha},\succeq^{R}_{\alpha}}$
\end_inset

.
 The direct relations are defined by
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\begin{aligned}x^{t}\succeq^{R,D}_{\alpha}x^{s} & \iff\alpha p^{t}\cdot x^{t}\geq p^{t}\cdot x^{s},\\
x^{t}\succ^{R,D}_{\alpha}x^{s} & \iff\alpha p^{t}\cdot x^{t}>p^{t}\cdot x^{s}.
\end{aligned}
\]

\end_inset


\end_layout

\begin_layout Standard
Let 
\begin_inset Formula $\succeq^{R}_{\alpha}$
\end_inset

 be the transitive closure of 
\begin_inset Formula $\succeq^{R,D}_{\alpha}$
\end_inset

.
 The dataset satisfies 
\begin_inset Formula $\alpha$
\end_inset

-GARP when every pair of observations 
\begin_inset Formula $s,t$
\end_inset

 obeys 
\begin_inset Formula 
\[
x^{t}\succeq^{R}_{\alpha}x^{s}\quad\Longrightarrow\quad\neg\bigl(x^{s}\succ^{R,D}_{\alpha}x^{t}\bigr).
\]

\end_inset


\end_layout

\begin_layout Definition
The Critical Cost Efficiency Index (CCEI) of a dataset 
\begin_inset Formula $\mathcal{O}$
\end_inset

 is 
\begin_inset Formula $\notationfirst{ccei}{\operatorname{CCEI}(\mathcal{O})}=\sup\{\alpha\in[0,1]:\mathcal{O}\text{ satisfies }\alpha\text{-GARP}\}$
\end_inset

.
 A value of one means that the original data satisfy GARP;
 a smaller value is the largest efficiency level at which the adjusted revealed-preference test remains free of GARP violations.
  This is an expenditure-efficiency normalization,
 not a claim that the recorded bundle was literally purchased after discarding the remaining expenditure.
\end_layout

