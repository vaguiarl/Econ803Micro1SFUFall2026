\begin_layout Section
First-Order and KKT Conditions
\end_layout

\begin_layout Standard
Assume that 
\begin_inset Formula $u$
\end_inset

 is continuously differentiable and that a constraint qualification holds at the candidate optimum.
 The KKT conditions are then necessary.
 If 
\begin_inset Formula $u$
\end_inset

 is concave,
 they are also sufficient for a global optimum;
 differentiability alone does not provide sufficiency.
\end_layout

\begin_layout Standard
The KKT conditions are as follows.
\end_layout

\begin_layout Standard
\begin_inset Formula $\notationfirst{lagrangian}{\mathcal{L}}=u(x)+\lambda(w-p\cdot x)$
\end_inset


\end_layout

\begin_layout Standard
Primal and dual feasibility require 
\begin_inset Formula $x^{*}\geq0$
\end_inset

,
 
\begin_inset Formula $w-p\cdot x^{*}\geq0$
\end_inset

,
 and 
\begin_inset Formula $\lambda^{*}\geq0$
\end_inset

.
\end_layout

\begin_layout Standard
\begin_inset Formula $\partial_{x_{\ell}}u(x^{*})\leq\lambda^{*}p_{\ell}$
\end_inset

 and 
\begin_inset Formula $x^{*}_{\ell}[\partial_{x_{\ell}}u(x^{*})-\lambda^{*}p_{\ell}]=0$
\end_inset

 for all 
\begin_inset Formula $\ell\in\{1,\ldots,L\}$
\end_inset

.
\end_layout

\begin_layout Standard
Complementary slackness is 
\begin_inset Formula $\lambda^{*}(w-p\cdot x^{*})=0$
\end_inset

.
\end_layout

\begin_layout Standard
This is a system with 
\begin_inset Formula $L+1$
\end_inset

 unknowns.
\end_layout

\begin_layout Standard
Local nonsatiation implies that the consumer is on the budget hyperplane (the frontier).
 This means that
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
w-p\cdot x^{*}=0.
\]

\end_inset

For an interior solution with a positive multiplier and nonzero marginal utilities,
 the KKT conditions reduce to
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\frac{\partial_{x_{\ell}}u(x^{*})}{\partial_{x_{k}}u(x^{*})}=\frac{p_{\ell}}{p_{k}}\quad\forall\ell,k\in\{1,\ldots,L\}.
\]

\end_inset


\end_layout

\begin_layout Standard
Note that for 
\begin_inset Formula $L=2$
\end_inset

,
\begin_inset Formula $-\frac{p_{1}}{p_{2}}$
\end_inset

 is the slope of the budget line and 
\begin_inset Formula $-\frac{\partial_{x_{1}}u(x^{*})}{\partial_{x_{2}}u(x^{*})}$
\end_inset

 is the slope of the indifference curve.
 Their equality is the familiar tangency condition expressed in terms of the marginal rate of substitution (MRS).
\end_layout

\begin_layout Standard
\begin_inset Note Note
status collapsed

\begin_layout Plain Layout
