\begin_layout Section
Revealed Preference and the Strong Axiom
\end_layout

\begin_layout Standard
The preceding section used GARP to characterize weak rationalization,
 allowing ties in observed choice.
 This section records the corresponding strict result:
 with single-valued choice and strict concavity,
 SARP replaces GARP and the Afriat inequalities become strict.
 The two results are parallel but answer different rationalizability questions.
\end_layout

\begin_layout Definition
(Strong Axiom of Revealed Preference -SARP-) The revealed preference relation 
\begin_inset Formula $R$
\end_inset

 is acyclic,
 i.e.,
 If 
\begin_inset Formula $x^{t}Rx^{s}$
\end_inset

 then it is not the case that 
\begin_inset Formula $x^{s}R^{D}x^{t}$
\end_inset

 (
\begin_inset Formula $t\neq s$
\end_inset

).
 
\end_layout

\begin_layout Standard
This is a result by Afriat/Varian/Houtaker.
\end_layout

\begin_layout Proposition
(Afriat's Theorem) Given 
\begin_inset Formula $\mathcal{O}=\{p^{k},x^{k}\}_{k=1}^{K}$
\end_inset

,
 the following are equivalent:
\end_layout

\begin_layout Proposition
1.
 There exists a continuous,
 nonsatiated utility function 
\begin_inset Formula $u$
\end_inset

,
 strictly concave that rationalizes the data in the sense that for all 
\begin_inset Formula $k$
\end_inset

,
 
\begin_inset Formula $u(x^{k})>u(x)$
\end_inset

 for all 
\begin_inset Formula $x\neq x^{k}$
\end_inset

 such that 
\begin_inset Formula $p^{k}\cdot x^{k}\geq p^{k}\cdot x$
\end_inset

.
 
\end_layout

\begin_layout Proposition
2.
 The dataset 
\begin_inset Formula $\mathcal{O}=\{p^{k},x^{k}\}_{k=1}^{K}$
\end_inset

 satisfies SARP.
 
\end_layout

\begin_layout Proposition
3.
 There exist numbers 
\begin_inset Formula $u^{t}\in\mathbb{R}$
\end_inset

 and 
\begin_inset Formula $\lambda^{t}>0$
\end_inset

 to the following system of linear inequalities:
\end_layout

\begin_layout Proposition
\begin_inset Formula 
\[
u^{t}<u^{s}+\lambda^{s}p^{s}\cdot (x^{t}-x^{s})\forall s,t\in\{1,\cdots,K\},s\neq t
\]

\end_inset


\end_layout

\begin_layout Section
Forecasting with Varian's Support Set
\end_layout

\begin_layout Definition
Given observed data 
\begin_inset Formula $\mathcal{O}=\{(p^{t},x^{t})\}_{t=1}^{K}$
\end_inset

 and a new price-wealth pair 
\begin_inset Formula $(p^{K+1},w^{K+1})$
\end_inset

,
 Varian's support set is
\begin_inset Formula 
\[
S(p^{K+1},w^{K+1})=\left\{x\in X:\begin{array}{l}\mathcal{O}\cup\{(p^{K+1},x)\}\text{ satisfies GARP},\\ p^{K+1}\cdot x=w^{K+1}\end{array}\right\}.
\]

\end_inset


\end_layout

\begin_layout Standard
The definition already gives the exact criterion: a candidate bundle belongs to the support set if it exhausts the new budget and the augmented dataset satisfies GARP.
 The transitive closure must be checked, not only one-step comparisons.
 Whenever an old bundle \begin_inset Formula $x^{t}$\end_inset
 is indirectly revealed preferred to the candidate, GARP requires
\begin_inset Formula $p^{K+1}\cdot x\leq p^{K+1}\cdot x^{t}$\end_inset
.
\end_layout

\begin_layout Section
Upper Bounds for Welfare Analysis
\end_layout

\begin_layout Definition
A money metric utility function is defined as 
\begin_inset Formula $m(p,x)=e(p,u(x))$
\end_inset

 where 
\begin_inset Formula $e$
\end_inset

 is the expenditure function associated with 
\begin_inset Formula $u$
\end_inset

,
 
\begin_inset Formula $e(p,\overline{u})=\min_{z\in X}\{p\cdot z:u(z)\geq\overline{u}\}$
\end_inset

.
 
\end_layout

\begin_layout Standard
For any given 
\begin_inset Formula $p$
\end_inset

,
 
\begin_inset Formula $m(p,x)$
\end_inset

 is a utility function that represents the same preferences as 
\begin_inset Formula $u$
\end_inset

 but is expressed in money units.
 
\end_layout

\begin_layout Standard
Given a finite dataset 
\begin_inset Formula $O$
\end_inset

 Varian proposes the following upper bound for money-metric utility:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
m^{+}(p,x)=\min_{t}px^{t},\quad s.t.x^{t}Rx.
\]

\end_inset


\end_layout

