\begin_inset Formula $\succeq$
\end_inset

.
\end_layout

\begin_layout Section
Attitudes towards Risk
\end_layout

\begin_layout Standard
Assume that the certainty set contains the convex hull of the finite prize set.  For a lottery \begin_inset Formula $p$\end_inset
,
 its expected monetary value is \begin_inset Formula $\overline z(p)=\sum_{z\in Z}zp(z)$\end_inset
 and the corresponding certain outcome is \begin_inset Formula $\delta_{\overline z(p)}$\end_inset
.
\end_layout

\begin_layout Definition
Risk aversion.
 A decision maker is risk averse if \begin_inset Formula $\delta_{\overline z(p)}\succeq p$\end_inset
 for every lottery \begin_inset Formula $p$\end_inset
.
 Under expected utility, risk aversion is equivalent to concavity of the Bernoulli utility:
\begin_inset Formula 
\[
\sum_{z\in Z}p(z)u(z)\leq u\!\left(\sum_{z\in Z}p(z)z\right).
\]
\end_inset
\end_layout

\begin_layout Definition
Certainty equivalent and risk premium.
 If \begin_inset Formula $u$\end_inset
 is strictly increasing and its range contains \begin_inset Formula $U(p)$\end_inset
,
 the certainty equivalent is the prize \begin_inset Formula $CE(p,u)=u^{-1}(U(p))$\end_inset
 and the (monetary) risk premium is \begin_inset Formula $\rho(p,u)=\overline z(p)-CE(p,u)$\end_inset
.
 A risk-averse expected-utility decision maker has \begin_inset Formula $\rho(p,u)\geq0$\end_inset
.
\end_layout

\begin_layout Definition
Probability premium.
 For prizes \begin_inset Formula $x-\varepsilon,x,x+\varepsilon$\end_inset
 in the certainty set, \begin_inset Formula $\pi(x,\varepsilon,u)$\end_inset
 is defined by
\begin_inset Formula 
\[
u(x)=\left(\frac12+\pi\right)u(x+\varepsilon)+\left(\frac12-\pi\right)u(x-\varepsilon).
\]
\end_inset
 It is the change in probability needed to make the symmetric two-point lottery equivalent to the sure prize.
\end_layout

\begin_layout Proposition
For a twice differentiable, strictly increasing Bernoulli utility, the local risk premium for a symmetric small spread satisfies
\begin_inset Formula 
\[
\rho\bigl(\tfrac12\delta_{x-\varepsilon}+\tfrac12\delta_{x+\varepsilon},u\bigr)
 =-\frac{u''(x)}{2u'(x)}\varepsilon^{2}+o(\varepsilon^{2}).
\]
\end_inset
 Thus local concavity corresponds to a nonnegative local risk premium.
\end_layout

\begin_layout Section
Expected Utility for Infinite Sets
\end_layout

\begin_layout Standard
Let 
\begin_inset Formula $Z$
\end_inset

 be a set of prizes,
 we say that the collection of subsets 
\begin_inset Formula $\Sigma\subseteq2^{Z}$
\end_inset

 is a 
\begin_inset Formula $\sigma$
\end_inset

-algebra when
\end_layout

\begin_layout Itemize
\begin_inset Formula $\emptyset\in\Sigma$
\end_inset


\end_layout

\begin_layout Itemize
if 
\begin_inset Formula $E\in\Sigma$
\end_inset

 then 
\begin_inset Formula $E^{c}\in\Sigma$
\end_inset


\end_layout

\begin_layout Itemize
If 
\begin_inset Formula $\{A_{n}\}$
\end_inset

 is a countable collection of sets such that 
\begin_inset Formula $A_{n}\in\Sigma$
\end_inset

 then 
\begin_inset Formula $\cup_{n}A_{n}\in\Sigma$
\end_inset

.
\end_layout

\begin_layout Standard
We say that 
\begin_inset Formula $(Z,\Sigma)$
\end_inset

 is a measurable space whenever 
\begin_inset Formula $\Sigma$
\end_inset

 is a 
\begin_inset Formula $\sigma-$
\end_inset

algebra.
 
\end_layout

\begin_layout Definition
We say that 
\begin_inset Formula $p:\Sigma\to[0,1]$
\end_inset

 is a probability measure if:
\end_layout

\begin_layout Itemize
\begin_inset Formula $p(Z)=1$
\end_inset


\end_layout

\begin_layout Itemize
if 
\begin_inset Formula $\{A_{n}\}$
\end_inset

 is a countable collection of pairwise disjoint sets such that 
\begin_inset Formula $A_{n}\in\Sigma$
\end_inset

,
 then 
\begin_inset Formula $p(\cup_{n}A_{n})=\sum_{n}p(A_{n})$
\end_inset

.
\end_layout

\begin_layout Standard
We call the collection of probability measures 
\begin_inset Formula $\Delta(Z,\Sigma)$
\end_inset

 for short 
\begin_inset Formula $\Delta(Z)$
\end_inset

 when 
\begin_inset Formula $\Sigma$
\end_inset

 is fixed.
 
\end_layout

\begin_layout Standard
\begin_inset Formula $\alpha p+(1-\alpha)q\in\Delta(Z)$
\end_inset

 is defined as 
\begin_inset Formula $(\alpha p+(1-\alpha)q)(E)=\alpha p(E)+(1-\alpha)q(E)$
\end_inset

.
 
\end_layout

\begin_layout Standard
We fix a topology on this space: 
\begin_inset Formula $p^{n}\xrightarrow{w^{*}}p$
\end_inset

 under the weak
\begin_inset Formula $*$
\end_inset

 topology if 
\begin_inset Formula $\int fdp^{n}\rightarrow\int fdp$
\end_inset

 for continuous and bounded functions 
\begin_inset Formula $f$
\end_inset

.
 
\end_layout

\begin_layout Axiom
(Weak-star continuity) For any 
\begin_inset Formula $p\in\Delta(Z)$
\end_inset

 the sets 
\begin_inset Formula $\{q\in\Delta(Z):q\succ p\}$
\end_inset

 and 
\begin_inset Formula $\{q\in\Delta(Z):p\succ q\}$
\end_inset

 are open in the weak* topology.
 
\end_layout

\begin_layout Standard
\begin_inset Separator parbreak
\end_inset


\end_layout

\begin_layout Theorem
Let 
\begin_inset Formula $Z$
\end_inset
 be a compact metric prize space and 
\begin_inset Formula $\Delta(Z)$
\end_inset
 the Borel probability measures with the weak-star topology.
 A rational preference relation 
\begin_inset Formula $\succeq$
\end_inset

