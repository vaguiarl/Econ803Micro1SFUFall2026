\begin_layout Section
Expected Utility on Infinite Outcome Spaces
\end_layout

\begin_layout Standard
Let 
\begin_inset Formula $Z$
\end_inset

 be a compact metric prize space and let 
\begin_inset Formula $\notationfirst{sigma-algebra}{\Sigma}$
\end_inset

 be its Borel 
\begin_inset Formula $\sigma\text{-algebra}$
\end_inset

.
 Recall that a collection of subsets is a 
\begin_inset Formula $\sigma\text{-algebra}$
\end_inset

 when
\end_layout

\begin_layout Itemize
\begin_inset Formula $\emptyset\in\Sigma$
\end_inset


\end_layout

\begin_layout Itemize
if 
\begin_inset Formula $E\in\Sigma$
\end_inset

 then 
\begin_inset Formula $E^{c}\in\Sigma$
\end_inset


\end_layout

\begin_layout Itemize
If 
\begin_inset Formula $\{A_{n}\}$
\end_inset

 is a countable collection of sets such that 
\begin_inset Formula $A_{n}\in\Sigma$
\end_inset

 then 
\begin_inset Formula $\cup_{n}A_{n}\in\Sigma$
\end_inset

.
\end_layout

\begin_layout Standard
We say that 
\begin_inset Formula $(Z,\Sigma)$
\end_inset

 is a measurable space whenever 
\begin_inset Formula $\Sigma$
\end_inset

 is a 
\begin_inset Formula $\sigma\text{-algebra}$
\end_inset

.
\end_layout

\begin_layout Definition
We say that 
\begin_inset Formula $\mu:\Sigma\to[0,1]$
\end_inset

 is a probability measure if:
\end_layout

\begin_layout Itemize
\begin_inset Formula $\mu(Z)=1$
\end_inset


\end_layout

\begin_layout Itemize
if 
\begin_inset Formula $\{A_{n}\}$
\end_inset

 is a countable collection of pairwise disjoint sets such that 
\begin_inset Formula $A_{n}\in\Sigma$
\end_inset

,
 then 
\begin_inset Formula $\mu(\cup_{n}A_{n})=\sum_{n}\mu(A_{n})$
\end_inset

.
\end_layout

\begin_layout Standard
We call the collection of probability measures 
\begin_inset Formula $\Delta(Z,\Sigma)$
\end_inset

 for short 
\begin_inset Formula $\Delta(Z)$
\end_inset

 when 
\begin_inset Formula $\Sigma$
\end_inset

 is fixed.
\end_layout

\begin_layout Standard
\begin_inset Formula $\alpha\mu+(1-\alpha)\nu\in\Delta(Z)$
\end_inset

 is defined as 
\begin_inset Formula $(\alpha\mu+(1-\alpha)\nu)(E)=\alpha\mu(E)+(1-\alpha)\nu(E)$
\end_inset

.
\end_layout

\begin_layout Standard
Equip this space with weak convergence:
 
\begin_inset Formula $\mu^{n}\notationfirst{weak-convergence}{\Rightarrow}\mu$
\end_inset

 if 
\begin_inset Formula $\int f\,d\mu^{n}\rightarrow\int f\,d\mu$
\end_inset

 for continuous and bounded functions 
\begin_inset Formula $f$
\end_inset

.
\end_layout

\begin_layout Axiom
(Weak continuity) For any 
\begin_inset Formula $\mu\in\Delta(Z)$
\end_inset

 the sets 
\begin_inset Formula $\{\nu\in\Delta(Z):\nu\succ\mu\}$
\end_inset

 and 
\begin_inset Formula $\{\nu\in\Delta(Z):\mu\succ\nu\}$
\end_inset

 are open in the weak topology.
\end_layout

\begin_layout Standard
\begin_inset Separator parbreak
\end_inset


\end_layout

\begin_layout Theorem
Let 
\begin_inset Formula $Z$
\end_inset

 be a compact metric prize space and 
\begin_inset Formula $\Delta(Z)$
\end_inset

 the Borel probability measures with the weak topology.
 A rational preference relation 
\begin_inset Formula $\succeq$
\end_inset

 on 
\begin_inset Formula $\Delta(Z)$
\end_inset

 satisfies the independence axiom and weak continuity if and only if there exists a 
\begin_inset Formula $u:Z\to\mathbb{R}$
\end_inset

 bounded and continuous such that 
\begin_inset Formula $U(\mu)=\int u(z)d\mu(z)$
\end_inset

 represents 
\begin_inset Formula $\succeq$
\end_inset

.
\end_layout

\begin_layout Section
First-Order Stochastic Dominance:
 General Distributions
\end_layout

\begin_layout Standard
This section extends the finite-prize result proved earlier in the chapter to probability distributions with integrable utility.
\end_layout

\begin_layout Definition
Let 
\begin_inset Formula $F$
\end_inset

 and 
\begin_inset Formula $G$
\end_inset

 be cumulative distribution functions on 
\begin_inset Formula $\mathbb{R}$
\end_inset

.
  Write 
\begin_inset Formula $F\succeq^{\mathrm{FOSD}}G$
\end_inset

 when 
\begin_inset Formula $F(r)\leq G(r)$
\end_inset

 for every 
\begin_inset Formula $r\in\mathbb{R}$
\end_inset

;
 strict dominance means that the inequality is strict at some continuity point.
\end_layout

\begin_layout Theorem
First-order stochastic dominance.
 If 
\begin_inset Formula $F\succeq^{\mathrm{FOSD}}G$
\end_inset

,
 then 
\begin_inset Formula $\int u\,dF\geq\int u\,dG$
\end_inset

 for every nondecreasing measurable Bernoulli utility 
\begin_inset Formula $u$
\end_inset

 for which both expectations are finite.
 If 
\begin_inset Formula $F\neq G$
\end_inset

 and 
\begin_inset Formula $u$
\end_inset

 is strictly increasing,
 the inequality is strict.
\end_layout

