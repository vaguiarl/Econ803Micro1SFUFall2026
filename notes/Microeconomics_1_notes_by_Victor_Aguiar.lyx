\begin_layout Chapter
Choice under Uncertainty
\end_layout

\begin_layout Standard
\begin_inset CommandInset label
LatexCommand label
name "chap:uncertainty"

\end_inset
\end_layout

\begin_layout Section
Primitives
\end_layout

\begin_layout Standard
Let \begin_inset Formula $Z\subseteq\mathbb{R}$\end_inset
 be a finite set of monetary prizes.  A lottery is a probability mass function \begin_inset Formula $p:Z\to[0,1]$\end_inset
 satisfying \begin_inset Formula $\sum_{z\in Z}p(z)=1$\end_inset
.
 Write \begin_inset Formula $\Delta(Z)$\end_inset
 for the set of lotteries and \begin_inset Formula $\delta_z$\end_inset
 for the degenerate lottery assigning probability one to \begin_inset Formula $z$\end_inset
.
 Mixtures are defined pointwise by
\end_layout

\begin_layout Standard
\begin_inset Formula
\[
[\alpha p+(1-\alpha)q](z)=\alpha p(z)+(1-\alpha)q(z),
\qquad \alpha\in[0,1].
\]
\end_inset
\end_layout

\begin_layout Standard
For a Bernoulli utility \begin_inset Formula $u:Z\to\mathbb{R}$\end_inset
,
 expected utility is \begin_inset Formula $U(p)=\sum_{z\in Z}u(z)p(z)$\end_inset
.
\end_layout

\begin_layout Section
Stochastic dominance on a finite prize set
\end_layout

\begin_layout Definition
First-order stochastic dominance.
 For lotteries \begin_inset Formula $p,q\in\Delta(Z)$\end_inset
 with cumulative distribution functions \begin_inset Formula $F_p(t)=\sum_{z\leq t}p(z)$\end_inset
 and \begin_inset Formula $F_q(t)=\sum_{z\leq t}q(z)$\end_inset
,
 write \begin_inset Formula $p\succeq^{FOSD}q$\end_inset
 if \begin_inset Formula $F_p(t)\leq F_q(t)$\end_inset
 for every \begin_inset Formula $t\in\mathbb{R}$\end_inset
.
 The relation is generally incomplete.
\end_layout

\begin_layout Theorem
If \begin_inset Formula $p\succeq^{FOSD}q$\end_inset
 and \begin_inset Formula $u$\end_inset
 is increasing, then \begin_inset Formula $U(p)\geq U(q)$\end_inset
 for expected utility \begin_inset Formula $U$\end_inset
.
 Strict inequality follows when the dominance is strict on a set that receives positive probability and \begin_inset Formula $u$\end_inset
 is strictly increasing there.
\end_layout

\begin_layout Section
Model and expected utility
\end_layout

\begin_layout Standard
We observe a choice correspondence on a family of subsets of \begin_inset Formula $\Delta(Z)$\end_inset
 and represent the decision maker's preference by a relation \begin_inset Formula $\succeq$\end_inset
 on lotteries.
\end_layout

\begin_layout Definition
Expected utility representation.
 The preference relation has an expected utility representation if there is a Bernoulli utility \begin_inset Formula $u:Z\to\mathbb{R}$\end_inset
 such that \begin_inset Formula $p\succeq q\iff\sum_{z\in Z}u(z)p(z)\geq\sum_{z\in Z}u(z)q(z)$\end_inset
.
\end_layout

\begin_layout Section
Independence Axiom
\end_layout

\begin_layout Standard
We are assuming 
\begin_inset Formula $\succeq$
\end_inset

 are rational.
\end_layout

\begin_layout Axiom
(Independence Axiom) For all 
\begin_inset Formula $p,q,r\in\Delta(Z)$
\end_inset

 and 
\begin_inset Formula $\alpha\in[0,1]$
\end_inset

,
 
\begin_inset Formula $p\succeq q$
\end_inset

 implies 
\begin_inset Formula $\alpha p+(1-\alpha)r\succeq\alpha q+(1-\alpha)r.$
\end_inset


\end_layout

\begin_layout Standard
The other axiom that we need is more technical
\end_layout

\begin_layout Axiom
(Mixture continuity) For all 
\begin_inset Formula $p,q,r\in\Delta(Z)$
\end_inset

,
 if 
\begin_inset Formula $p\succ q\succ r$
\end_inset

,
 then the set 
\begin_inset Formula $\{\alpha\in[0,1]|\alpha p+(1-\alpha)r\succ q\}$
\end_inset

 and 
\begin_inset Formula $\{\alpha\in[0,1]|q\succ\alpha p+(1-\alpha)r\}$
\end_inset

 are open in 
\begin_inset Formula $[0,1]$
\end_inset

.

\end_layout

\begin_layout Section
Representation Theorem
\end_layout

\begin_layout Theorem
The rational preference relation 
\begin_inset Formula $\succeq$
\end_inset

 satisfies the Independence Axiom and Mixture continuity if and only if there exists a (Bernoulli) utility function 
\begin_inset Formula $u:Z\to\mathbb{R}$
\end_inset

 such that:
 
\begin_inset Formula $p\succeq q$
\end_inset

 if and only if 
\begin_inset Formula $\sum_{z\in Z}u(z)p(z)\geq\sum_{z\in Z}u(z)q(z)$
\end_inset

.

\end_layout

\begin_layout Standard
First we prove that there is an affine representation of 
\begin_inset Formula $\succeq$
\end_inset

.

\end_layout

\begin_layout Lemma
If the preference relation 
\begin_inset Formula $\succeq$
\end_inset

 satisfies the Independence Axiom and mixture continuity then there is an affine function 
\begin_inset Formula $U:\Delta(Z)\to\mathbb{R}$
\end_inset

 that represents 
\begin_inset Formula $\succeq$
\end_inset

.
\end_layout

\begin_layout Standard
\begin_inset ERT
status open

\begin_layout Plain Layout


\backslash
begin{proof}
\end_layout

\end_inset


\end_layout

\begin_layout Standard
Choose best and worst degenerate lotteries 
\begin_inset Formula $p^{+}=\delta_{z^{+}}$
\end_inset
 and 
\begin_inset Formula $p^{-}=\delta_{z^{-}}$
\end_inset
 among the finitely many prizes.
 Repeated use of independence shows 
\begin_inset Formula $p^{+}\succeq p\succeq p^{-}$
\end_inset
 for every lottery 
\begin_inset Formula $p$
\end_inset
.
 If 
\begin_inset Formula $p^{+}\sim p^{-}$
\end_inset
, all lotteries are indifferent and a constant affine representation works.
 Otherwise, independence implies
\begin_inset Formula
\[
\beta p^{+}+(1-\beta)p^{-}\succ\alpha p^{+}+(1-\alpha)p^{-}
\quad\Longleftrightarrow\quad \beta>\alpha.
\]

\end_inset
For a fixed 
\begin_inset Formula $p$
\end_inset
, mixture continuity makes the two sets of mixture weights giving an outcome weakly above or weakly below 
\begin_inset Formula $p$
\end_inset
 closed.
 They cover the connected interval 
\begin_inset Formula $[0,1]$
\end_inset
 and contain opposite endpoints, so they intersect.
 Strict monotonicity along the best--worst segment gives a unique 
\begin_inset Formula $\alpha_p$
\end_inset
 with
\begin_inset Formula
\[
p\sim\alpha_p p^{+}+(1-\alpha_p)p^{-}.
\]

\end_inset
Thus 
\begin_inset Formula $U(p)=\alpha_p$
\end_inset
 represents 
\begin_inset Formula $\succeq$
\end_inset
.
 Finally, independence permits substitution of the equivalent best--worst mixtures for 
\begin_inset Formula $p$
\end_inset
 and 
\begin_inset Formula $q$
\end_inset
, yielding
\begin_inset Formula
\[
U(\beta p+(1-\beta)q)=\beta U(p)+(1-\beta)U(q).
\]

\end_inset
Hence 
\begin_inset Formula $U$
\end_inset
 is affine on the lottery simplex.
\end_layout

\begin_layout Standard
\begin_inset ERT
status open

\begin_layout Plain Layout


\backslash
end{proof}
\end_layout

\end_inset


\end_layout

\begin_layout Standard
The second step is to show that an affine representation on the lottery simplex has the expected-utility form.

\end_layout

\begin_layout Lemma
Let 
\begin_inset Formula $U:\Delta(Z)\to\mathbb{R}$
\end_inset

.
 Then 
\begin_inset Formula $U$
\end_inset

 is affine if and only if there exists a 
\begin_inset Formula $u:Z\to\mathbb{R}$
\end_inset

 such that 
\begin_inset Formula $U(p)=\sum_{z\in Z}u(z)p(z)$
\end_inset

.

\end_layout

\begin_layout Standard
For finite 
\begin_inset Formula $Z$
\end_inset
, no functional-analytic representation theorem is needed.
 Define 
\begin_inset Formula $u(z)=U(\delta_z)$
\end_inset
.
 Since every lottery has the finite decomposition 
\begin_inset Formula $p=\sum_{z\in Z}p(z)\delta_z$
\end_inset
, affinity of 
\begin_inset Formula $U$
\end_inset
 gives 
\begin_inset Formula $U(p)=\sum_{z\in Z}u(z)p(z)$
\end_inset
.
 The converse follows immediately from distributivity.

\end_layout

\begin_layout Example
Let 
\begin_inset Formula $Z=\{0,10\}$
\end_inset

, and let 
\begin_inset Formula $p\in\Delta(Z)$
\end_inset

 satisfy 
\begin_inset Formula $p(0)=p(10)=\frac{1}{2}$
\end_inset

.
 Then 
\begin_inset Formula $U(p)=\frac{1}{2}u(10)+\frac{1}{2}u(0)$
\end_inset

.
 Normalize the Bernoulli index by 
\begin_inset Formula $u(0)=0$
\end_inset
 and 
\begin_inset Formula $u(10)=1$
\end_inset
.
 The normalized expected utility is therefore 
\begin_inset Formula $U(p)=1/2$
\end_inset
.
 Any positive affine transformation of this index represents the same preference.
\end_layout

\begin_layout Section
Recoverability
\end_layout

\begin_layout Theorem
Let 
\begin_inset Formula $U:\Delta(Z)\to\mathbb{R}$
\end_inset

 and 
\begin_inset Formula $U':\Delta(Z)\to\mathbb{R}$
\end_inset

 be affine maps that represent 
\begin_inset Formula $\succeq$
\end_inset

 on 
\begin_inset Formula $\Delta(Z)$
\end_inset

,
 then there exist real numbers 
\begin_inset Formula $\alpha>0$
\end_inset

 and 
\begin_inset Formula $b$
\end_inset

 such that 
\begin_inset Formula $U'(p)=\alpha U(p)+b$
\end_inset

 for all 
\begin_inset Formula $p\in\Delta(Z)$
\end_inset

.
 If 
\begin_inset Formula $u,v$
\end_inset

 are Bernoulli utilities such that 
\begin_inset Formula $u\cdot p$
\end_inset

 and 
\begin_inset Formula $v\cdot p$
\end_inset

 represent 
\begin_inset Formula $\succeq$
\end_inset

 then there are real numbers 
\begin_inset Formula $\alpha>0$
\end_inset

 and 
\begin_inset Formula $b$
\end_inset

 such that 
\begin_inset Formula $v\cdot p=\alpha u\cdot p+b$
\end_inset

.

\end_layout

\begin_layout Standard
Think about this.
 How it differs from the recoverability result of the common rational preference 
\begin_inset Formula $\succeq$
\end_inset

.
\end_layout

\begin_layout Section
Attitudes towards Risk
\end_layout

\begin_layout Standard
Assume that Bernoulli utility is defined on the convex hull \begin_inset Formula $\operatorname{co}(Z)$\end_inset
 of the finite monetary-prize set.  For a lottery \begin_inset Formula $p$\end_inset
,
 its expected monetary value is \begin_inset Formula $\overline z(p)=\sum_{z\in Z}zp(z)$\end_inset
 and the corresponding certain outcome is \begin_inset Formula $\delta_{\overline z(p)}$\end_inset
.
\end_layout

\begin_layout Definition
Risk aversion.
 A decision maker is risk averse if \begin_inset Formula $\delta_{\overline z(p)}\succeq p$\end_inset
 for every lottery \begin_inset Formula $p$\end_inset
.
 Under expected utility, risk aversion is equivalent to concavity of the Bernoulli utility:
\begin_inset Formula
\[
\sum_{z\in Z}p(z)u(z)\leq u\!\left(\sum_{z\in Z}p(z)z\right).
\]
\end_inset
\end_layout

\begin_layout Definition
Certainty equivalent and risk premium.
 If \begin_inset Formula $u$\end_inset
 is strictly increasing and its range contains \begin_inset Formula $U(p)$\end_inset
,
 the certainty equivalent is the prize \begin_inset Formula $\operatorname{CE}(p,u)=u^{-1}(U(p))$\end_inset
 and the (monetary) risk premium is \begin_inset Formula $\rho(p,u)=\overline z(p)-\operatorname{CE}(p,u)$\end_inset
.
 A risk-averse expected-utility decision maker has \begin_inset Formula $\rho(p,u)\geq0$\end_inset
.
\end_layout

\begin_layout Definition
Probability premium.
 For prizes \begin_inset Formula $x-\varepsilon,x,x+\varepsilon$\end_inset
 in the certainty set, \begin_inset Formula $\pi(x,\varepsilon,u)$\end_inset
 is defined by
\begin_inset Formula
\[
u(x)=\left(\frac12+\pi\right)u(x+\varepsilon)+\left(\frac12-\pi\right)u(x-\varepsilon).
\]
\end_inset
 It is the change in probability needed to make the symmetric two-point lottery equivalent to the sure prize.
\end_layout

\begin_layout Proposition
For a twice differentiable, strictly increasing Bernoulli utility, the local risk premium for a symmetric small spread satisfies
\begin_inset Formula
\[
\rho\bigl(\tfrac12\delta_{x-\varepsilon}+\tfrac12\delta_{x+\varepsilon},u\bigr)
 =-\frac{u''(x)}{2u'(x)}\varepsilon^{2}+o(\varepsilon^{2}).
\]
\end_inset
 Thus local concavity corresponds to a nonnegative local risk premium.
\end_layout

\begin_layout Section
Expected Utility for Infinite Sets
\end_layout

\begin_layout Standard
Let 
\begin_inset Formula $Z$
\end_inset
 be a compact metric prize space and let 
\begin_inset Formula $\Sigma$
\end_inset
 be its Borel 
\begin_inset Formula $\sigma\text{-algebra}$
\end_inset
.
 Recall that a collection of subsets is a 
\begin_inset Formula $\sigma\text{-algebra}$
\end_inset
 when
\end_layout

\begin_layout Itemize
\begin_inset Formula $\emptyset\in\Sigma$
\end_inset


\end_layout

\begin_layout Itemize
if 
\begin_inset Formula $E\in\Sigma$
\end_inset

 then 
\begin_inset Formula $E^{c}\in\Sigma$
\end_inset


\end_layout

\begin_layout Itemize
If 
\begin_inset Formula $\{A_{n}\}$
\end_inset

 is a countable collection of sets such that 
\begin_inset Formula $A_{n}\in\Sigma$
\end_inset

 then 
\begin_inset Formula $\cup_{n}A_{n}\in\Sigma$
\end_inset

.
\end_layout

\begin_layout Standard
We say that 
\begin_inset Formula $(Z,\Sigma)$
\end_inset

 is a measurable space whenever 
\begin_inset Formula $\Sigma$
\end_inset

 is a 
\begin_inset Formula $\sigma\text{-algebra}$
\end_inset
.

\end_layout

\begin_layout Definition
We say that 
\begin_inset Formula $p:\Sigma\to[0,1]$
\end_inset

 is a probability measure if:
\end_layout

\begin_layout Itemize
\begin_inset Formula $p(Z)=1$
\end_inset


\end_layout

\begin_layout Itemize
if 
\begin_inset Formula $\{A_{n}\}$
\end_inset

 is a countable collection of pairwise disjoint sets such that 
\begin_inset Formula $A_{n}\in\Sigma$
\end_inset

,
 then 
\begin_inset Formula $p(\cup_{n}A_{n})=\sum_{n}p(A_{n})$
\end_inset

.
\end_layout

\begin_layout Standard
We call the collection of probability measures 
\begin_inset Formula $\Delta(Z,\Sigma)$
\end_inset

 for short 
\begin_inset Formula $\Delta(Z)$
\end_inset

 when 
\begin_inset Formula $\Sigma$
\end_inset

 is fixed.

\end_layout

\begin_layout Standard
\begin_inset Formula $\alpha p+(1-\alpha)q\in\Delta(Z)$
\end_inset

 is defined as 
\begin_inset Formula $(\alpha p+(1-\alpha)q)(E)=\alpha p(E)+(1-\alpha)q(E)$
\end_inset

.

\end_layout

\begin_layout Standard
Equip this space with weak convergence: 
\begin_inset Formula $p^{n}\Rightarrow p$
\end_inset
 if 
\begin_inset Formula $\int fdp^{n}\rightarrow\int fdp$
\end_inset

 for continuous and bounded functions 
\begin_inset Formula $f$
\end_inset

.

\end_layout

\begin_layout Axiom
(Weak continuity) For any 
\begin_inset Formula $p\in\Delta(Z)$
\end_inset

 the sets 
\begin_inset Formula $\{q\in\Delta(Z):q\succ p\}$
\end_inset

 and 
\begin_inset Formula $\{q\in\Delta(Z):p\succ q\}$
\end_inset

 are open in the weak topology.

\end_layout

\begin_layout Standard
\begin_inset Separator parbreak
\end_inset


\end_layout

\begin_layout Theorem
Let 
\begin_inset Formula $Z$
\end_inset
 be a compact metric prize space and 
\begin_inset Formula $\Delta(Z)$
\end_inset
 the Borel probability measures with the weak topology.
 A rational preference relation 
\begin_inset Formula $\succeq$
\end_inset

 on 
\begin_inset Formula $\Delta(Z)$
\end_inset

 satisfies the independence axiom and weak continuity if and only if there exists a 
\begin_inset Formula $u:Z\to\mathbb{R}$
\end_inset

 bounded and continuous such that 
\begin_inset Formula $U(p)=\int u(z)dp(z)$
\end_inset

 represents 
\begin_inset Formula $\succeq$
\end_inset

.
\end_layout

\begin_layout Section
Application:
 Demand for a Risky Asset

\end_layout

\begin_layout Standard
An asset is a divisible claim to a financial return in the future.
 Assume that 
\begin_inset Formula $u$
\end_inset
 is continuously differentiable, strictly increasing, and concave on an interval containing every feasible terminal-wealth realization.
 Assume also that the return and marginal-utility expressions below are integrable.

\end_layout

\begin_layout Standard
Let 
\begin_inset Formula $\alpha,\beta$
\end_inset

 denote the amounts of money invested in a risky and safe asset respectively.
 The risky asset pays a random return of 
\begin_inset Formula $Z$
\end_inset

 dollars per dollar invested and the safe asset pays 
\begin_inset Formula $1$
\end_inset

 dollar with certainty per dollar invested.
 The random return has a distribution 
\begin_inset Formula $F(z)$
\end_inset

 (CDF).
 We assume that 
\begin_inset Formula $\int zdF(z)>1$
\end_inset

,
 or that the risky asset expected return exceeds the return of the safe asset.
 Then the total return is 
\begin_inset Formula $\alpha Z+\beta$
\end_inset

.
 Feasibility requires 
\begin_inset Formula $\alpha+\beta=w$
\end_inset

.

\end_layout

\begin_layout Standard
\begin_inset Formula
\[
\max_{\alpha,\beta\geq0}\int u(\alpha z+\beta)dF(z)
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula
\[
\text{subject to}\quad\alpha+\beta=w.
\]

\end_inset


\end_layout

\begin_layout Standard
Equivalently we want to solve.
