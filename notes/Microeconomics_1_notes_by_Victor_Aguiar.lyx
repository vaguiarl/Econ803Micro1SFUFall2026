\begin_layout Section
Roy's Identity
\end_layout

\begin_layout Standard
Assume the maximizer is unique,
 denote it by 
\begin_inset Formula $x(p,w)$
\end_inset

,
 and assume the value function is differentiable.
 Then 
\begin_inset Formula $v(p,w)=u(x(p,w))$
\end_inset

.
  The envelope theorem applied to
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
v(p,w)=\max_{x\geq0,\;p\cdot x\leq w}u(x)
\]

\end_inset


\end_layout

\begin_layout Standard
gives
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\partial_{w}v(p,w)=\lambda(p,w),\qquad\nabla_{p}v(p,w)=-\lambda(p,w)x(p,w).
\]

\end_inset


\end_layout

\begin_layout Standard
If demand is unique,
 the envelope derivatives exist,
 and 
\begin_inset Formula $\partial_{w}v(p,w)=\lambda(p,w)>0$
\end_inset

,
 Roy's identity is
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
x(p,w)=-\frac{\nabla_{p}v(p,w)}{\partial_{w}v(p,w)}.
\]

\end_inset


\end_layout

\begin_layout Example
Quasilinear demand and Roy's identity.
 Let good 
\begin_inset Formula $L$
\end_inset

 be the numeraire,
 set 
\begin_inset Formula $p_{L}=1$
\end_inset

,
 and let utility be 
\begin_inset Formula $u(q,q_{L})=g(q)+q_{L}$
\end_inset

 for 
\begin_inset Formula $q\in\mathbb{R}^{L-1}_{+}$
\end_inset

.
 Write 
\begin_inset Formula $p_{-L}=(p_{1},\ldots,p_{L-1})$
\end_inset

 for the nonnumeraire price vector.
 Feasibility of the nonnegative numeraire requires 
\begin_inset Formula $p_{-L}\cdot q\leq w$
\end_inset

.
 The indirect utility is
\end_layout

\begin_layout Example
\begin_inset Formula 
\[
v(p,w)=w+\max_{q\geq0,\;p_{-L}\cdot q\leq w}\{g(q)-p_{-L}\cdot q\}.
\]

\end_inset


\end_layout

\begin_layout Standard
When the unconstrained maximizer of 
\begin_inset Formula $g(q)-p_{-L}\cdot q$
\end_inset

 is affordable and leaves a nonnegative numeraire,
 the wealth constraint inside the displayed maximum is slack and non-numeraire demands have no income effects.
 When the maximizer is unique and the envelope theorem applies,
 Roy's identity gives 
\begin_inset Formula $x_{k}(p,w)=-\partial_{p_{k}}v(p,w)$
\end_inset

 for 
\begin_inset Formula $k<L$
\end_inset

,
 and the numeraire demand is the residual 
\begin_inset Formula $x_{L}=w-p_{-L}\cdot x_{-L}(p)$
\end_inset

,
 where 
\begin_inset Formula $x_{-L}(p)$
\end_inset

 collects the demands for the nonnumeraire goods and 
\begin_inset Formula $p_{-L}$
\end_inset

 is their price vector.
\end_layout

