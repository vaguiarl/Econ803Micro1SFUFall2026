\end_layout

\end_inset


\end_layout

\begin_layout Section
KKT Conditions for Expenditure Minimization
\end_layout

\begin_layout Standard
Assume 
\begin_inset Formula $u$
\end_inset

 is continuously differentiable and a constraint qualification holds at the candidate optimum.
 The KKT conditions below are necessary.
 If 
\begin_inset Formula $u$
\end_inset

 is concave,
 they are also sufficient.
\end_layout

\begin_layout Standard
The Lagrangian for this problem is:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\mathcal{L}_{\mathrm{EMP}}=p\cdot x-\lambda(u(x)-\overline{u}).
\]

\end_inset


\end_layout

\begin_layout Standard
Stationarity and complementary slackness for the nonnegativity constraints give
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
p\geq\lambda\nabla_{x}u(x^{*})
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
x^{*}_{\ell}[p_{\ell}-\lambda\nabla u(x^{*})_{\ell}]=0,
\]

\end_inset


\end_layout

\begin_layout Standard
for some 
\begin_inset Formula $\lambda\geq0$
\end_inset

,
 together with primal feasibility 
\begin_inset Formula $x^{*}\geq0$
\end_inset

 and 
\begin_inset Formula $u(x^{*})\geq\overline{u}$
\end_inset

,
 and complementary slackness 
\begin_inset Formula $\lambda[u(x^{*})-\overline{u}]=0$
\end_inset

.
\end_layout

\begin_layout Standard
\begin_inset Note Note
status collapsed

