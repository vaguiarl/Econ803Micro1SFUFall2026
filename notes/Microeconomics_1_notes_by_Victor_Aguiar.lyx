\begin_layout Section
Hicksian Compensated Demand
\end_layout

\begin_layout Standard
The Hicksian (compensated) demand correspondence is the solution set of the EMP:
 
\begin_inset Formula $h(p,\overline{u})=\arg\min\{p\cdot x:x\in X,\ u(x)\geq\overline{u}\}$
\end_inset

.
\end_layout

\begin_layout Proposition
Suppose 
\begin_inset Formula $u(\cdot)$
\end_inset

 is continuous and represents a locally nonsatiated preference relation 
\begin_inset Formula $\succeq$
\end_inset

,
 prices satisfy 
\begin_inset Formula $p\gg0$
\end_inset

,
 and the attainable target satisfies 
\begin_inset Formula $\overline{u}>u(0)$
\end_inset

.
 Then 
\begin_inset Formula $h(p,\overline{u})$
\end_inset

 is nonempty and compact-valued and has the following properties:
\end_layout

\begin_layout Proposition
(i) It is homogeneous of degree zero in 
\begin_inset Formula $p$
\end_inset


\end_layout

\begin_layout Proposition
(ii) It has no excess utility:
 For 
\begin_inset Formula $x^{*}\in h(p,\overline{u})$
\end_inset

,
 
\begin_inset Formula $u(x^{*})=\overline{u}$
\end_inset


\end_layout

\begin_layout Proposition
(iii) Convexity and uniqueness:
 If 
\begin_inset Formula $\succeq$
\end_inset

 is convex,
 then 
\begin_inset Formula $h(p,\overline{u})$
\end_inset

 is convex;
 if 
\begin_inset Formula $\succeq$
\end_inset

 is strictly convex,
 then Hicksian demand is single-valued.
\end_layout

\begin_layout Standard
\begin_inset Note Note
status collapsed

\begin_layout Plain Layout
