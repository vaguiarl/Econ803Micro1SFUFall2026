\begin_layout Section
Examples and Applications of Demand Integrability
\end_layout

\begin_layout Standard
Consider two commodities,
 
\begin_inset Formula $L=2$
\end_inset

,
 and a parameter 
\begin_inset Formula $0<\alpha<1$
\end_inset

.
 Suppose observed demand for good 1 is
\begin_inset Formula $x_{1}(p,w)=\frac{\alpha w}{p_{1}}$
\end_inset

.
 Normalize 
\begin_inset Formula $p_{2}=1$
\end_inset

,
 and impose Walras' law.
 Demand for good 2 is then the budget residual,
\begin_inset Formula $x_{2}=w-p_{1}x_{1}=(1-\alpha)w$
\end_inset

.
 The following calculation recovers a normalized indirect utility and then a direct utility representation.
\end_layout

\begin_layout Standard
Fix an initial price--wealth pair 
\begin_inset Formula $(p^{0}_{1},w^{0})\in\mathbb{R}^{2}_{++}$
\end_inset

.
 For 
\begin_inset Formula $\xi>0$
\end_inset

,
 let 
\begin_inset Formula $\chi(\xi;p^{0}_{1},w^{0})$
\end_inset

 denote the wealth required at prices 
\begin_inset Formula $(\xi,1)$
\end_inset

 to remain on the indifference curve through the initial pair.
 The integrability differential equation and its initial condition are
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\frac{\partial\chi(\xi;p^{0}_{1},w^{0})}{\partial\xi}=x_{1}\!\left((\xi,1),\chi(\xi;p^{0}_{1},w^{0})\right)=\frac{\alpha\chi(\xi;p^{0}_{1},w^{0})}{\xi},\qquad\chi(p^{0}_{1};p^{0}_{1},w^{0})=w^{0}.
\]

\end_inset


\end_layout

\begin_layout Standard
The unique positive solution is
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\chi(\xi;p^{0}_{1},w^{0})=w^{0}\left(\frac{\xi}{p^{0}_{1}}\right)^{\alpha}.
\]

\end_inset


\end_layout

\begin_layout Standard
Using 
\begin_inset Formula $(1,1)$
\end_inset

 as the reference price vector gives the normalization
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
v(p_{1},w):=\chi(1;p_{1},w)=\frac{w}{p^{\alpha}_{1}}.
\]

\end_inset


\end_layout

\begin_layout Standard
For any bundle 
\begin_inset Formula $(x_{1},x_{2})\gg0$
\end_inset

,
 invert the two demand equations to recover the normalized price and wealth that generate it:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
x_{1}(p,w)=\frac{\alpha w}{p_{1}};\quad x_{2}(p,w)=(1-\alpha)w
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\frac{x_{1}}{x_{2}}=\frac{\alpha}{(1-\alpha)}\frac{1}{p_{1}}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
p_{1}=\frac{\alpha}{1-\alpha}\frac{x_{2}}{x_{1}},\quad w=\frac{x_{2}}{1-\alpha}.
\]

\end_inset


\end_layout

\begin_layout Standard
Substituting these inverse-demand expressions into the normalized indirect utility gives
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
u(x_{1},x_{2}):=v\!\left(\frac{\alpha}{1-\alpha}\frac{x_{2}}{x_{1}},\frac{x_{2}}{1-\alpha}\right).
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
u(x_{1},x_{2})=\frac{\frac{x_{2}}{1-\alpha}}{\left(\frac{\alpha}{1-\alpha}\frac{x_{2}}{x_{1}}\right)^{\alpha}}=\left(\frac{x_{2}}{1-\alpha}\right)^{1-\alpha}\left(\frac{x_{1}}{\alpha}\right)^{\alpha}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
u(x_{1},x_{2})=\hat{c}x^{\alpha}_{1}x^{1-\alpha}_{2},\quad\hat{c}=\frac{1}{\alpha^{\alpha}(1-\alpha)^{1-\alpha}}.
\]

\end_inset


\end_layout

\begin_layout Standard
This is a Cobb-Douglas utility function.
\end_layout

\begin_layout Standard
\begin_inset Note Note
status collapsed

\begin_layout Plain Layout
