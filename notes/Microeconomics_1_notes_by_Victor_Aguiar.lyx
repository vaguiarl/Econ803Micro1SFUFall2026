\end_layout

\end_inset


\end_layout

\begin_layout Section
Curvature of Hicksian Demand
\end_layout

\begin_layout Standard
Assume throughout this subsection that 
\begin_inset Formula $e(\cdot,\overline{u})$
\end_inset

 is twice continuously differentiable,
 so Hicksian demand is single-valued and differentiable.
 The Jacobian 
\begin_inset Formula $D_{p}h(p,\overline{u})$
\end_inset

 has entries 
\begin_inset Formula $[D_{p}h(p,\overline{u})]_{k\ell}=\partial_{p_{\ell}}h_{k}(p,\overline{u})$
\end_inset

.
\end_layout

\begin_layout Proposition
The Hicksian price-effect matrix satisfies 
\begin_inset Formula 
\[
D_{p}h(p,\overline{u})=D^{2}_{p}e(p,\overline{u}).
\]

\end_inset

 It is symmetric and negative semidefinite,
 and 
\begin_inset Formula $D_{p}h(p,\overline{u})p=0$
\end_inset

.
 The first claims follow from Shephard's identity,
 twice continuous differentiability,
 and concavity of the expenditure function.
 The last follows by differentiating the degree-zero homogeneity of Hicksian demand.
\end_layout

\begin_layout Definition
Negative semidefiniteness.
 A symmetric 
\begin_inset Formula $L\times L$
\end_inset

 matrix 
\begin_inset Formula $A$
\end_inset

 is negative semidefinite if 
\begin_inset Formula $z^{\top}Az\leq0$
\end_inset

 for every vector 
\begin_inset Formula $z\in\mathbb{R}^{L}$
\end_inset

.
\end_layout

\begin_layout Standard
\begin_inset Separator plain
\end_inset


\end_layout

\begin_layout Example
The following matrix is NSD:
\end_layout

\begin_layout Example
\begin_inset Formula 
\[
A=\left[\begin{array}{cc}
-2 & 0\\
0 & 0
\end{array}\right]
\]

\end_inset


\end_layout

\begin_layout Example
\begin_inset Formula 
\[
z^{\top}Az=-2z^{2}_{1}\leq0
\]

\end_inset

 for any 
\begin_inset Formula $z\in\mathbb{R}^{2}$
\end_inset

.
\end_layout

\begin_layout Standard
\begin_inset Note Note
status collapsed

\begin_layout Plain Layout
ECON803_CONSUMER_RESTRUCTURE_SOURCE:section:consumer-theory-utility-maximization:12:summary-of-relationships-between-the-emp-and-ump
\end_layout

\end_inset


\end_layout

\begin_layout Section
Consumer Duality
\end_layout

\begin_layout Standard
The expenditure function is the value of the EMP:
 for every 
\begin_inset Formula $x^{h}\in h(p,\overline{u})$
\end_inset

,
\begin_inset Formula $e(p,\overline{u})=p\cdot x^{h}$
\end_inset

.
\end_layout

\begin_layout Proposition
Consumer duality.
 Suppose that 
\begin_inset Formula $u$
\end_inset

 is continuous and represents a locally nonsatiated preference relation on 
\begin_inset Formula $X=\mathbb{R}^{L}_{+}$
\end_inset

.
 For 
\begin_inset Formula $p\gg0$
\end_inset

,
 
\begin_inset Formula $w>0$
\end_inset

,
 and every attainable target 
\begin_inset Formula $\overline{u}\in u(X)$
\end_inset

 with 
\begin_inset Formula $\overline{u}>u(0)$
\end_inset

,
 the demand and value functions satisfy
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\begin{aligned}h(p,v(p,w)) & =x(p,w),\\
x(p,e(p,\overline{u})) & =h(p,\overline{u}),\\
v(p,e(p,\overline{u})) & =\overline{u},\\
e(p,v(p,w)) & =w.
\end{aligned}
\]

\end_inset

 The first two equalities are equalities of correspondences;
 when demand is single-valued,
 the same notation denotes functions.
 The restriction 
\begin_inset Formula $\overline{u}>u(0)$
\end_inset

 ensures 
\begin_inset Formula $e(p,\overline{u})>0$
\end_inset

,
 so the Marshallian demand appearing in the second and third identities lies in the declared wealth domain.
 At the boundary target 
\begin_inset Formula $u(0)$
\end_inset

,
 the identities require an explicit extension of Marshallian demand to zero wealth.
\end_layout

\begin_layout Proof
Choose 
\begin_inset Formula $x^{m}\in x(p,w)$
\end_inset

.
 Local nonsatiation gives 
\begin_inset Formula $p\cdot x^{m}=w$
\end_inset

.
 If a bundle delivered utility at least 
\begin_inset Formula $v(p,w)$
\end_inset

 at expenditure strictly below 
\begin_inset Formula $w$
\end_inset

,
 local nonsatiation would provide a strictly preferred nearby bundle still inside 
\begin_inset Formula $B(p,w)$
\end_inset

,
 contradicting the definition of the value function.
 Thus the expenditure needed to reach 
\begin_inset Formula $v(p,w)$
\end_inset

 is exactly 
\begin_inset Formula $w$
\end_inset

,
 and the minimizers are exactly the Marshallian maximizers.
 For an attainable 
\begin_inset Formula $\overline{u}>u(0)$
\end_inset

,
 continuity and positive prices ensure that the EMP has a minimizer 
\begin_inset Formula $x^{h}$
\end_inset

 and that its expenditure is positive.
 Its utility target binds:
 if 
\begin_inset Formula $u(x^{h})>\overline{u}$
\end_inset

,
 continuity along the segment from 
\begin_inset Formula $0$
\end_inset

 to 
\begin_inset Formula $x^{h}$
\end_inset

 would produce the target utility at strictly lower expenditure.
 No bundle affordable at 
\begin_inset Formula $e(p,\overline{u})$
\end_inset

 can yield utility strictly above 
\begin_inset Formula $\overline{u}$
\end_inset

,
 because the same segment argument would again contradict expenditure minimality.
 Hence 
\begin_inset Formula $v(p,e(p,\overline{u}))=\overline{u}$
\end_inset

,
 and budget exhaustion identifies the two demand correspondences.
\end_layout

\begin_layout Standard
\begin_inset Note Note
status collapsed

\begin_layout Plain Layout
ECON803_CONSUMER_RESTRUCTURE_SOURCE:section:consumer-theory-utility-maximization:13:slutsky-equation
\end_layout

\end_inset


\end_layout

\begin_layout Section
Slutsky Equation
\end_layout

\begin_layout Standard
Assume in this section that Marshallian and Hicksian demands are single-valued and continuously differentiable and that the expenditure function is differentiable in prices.
 The Slutsky matrix is 
\begin_inset Formula $S:\mathsf{P}\times\mathsf{W}\to\mathbb{R}^{L\times L}$
\end_inset

,
 
\begin_inset Formula $S(p,w)_{\ell,k}=\partial_{p_{k}}x_{\ell}(p,w)+\partial_{w}x_{\ell}(p,w)x_{k}(p,w)$
\end_inset

,
 
\begin_inset Formula $S(p,w)=D_{p}x(p,w)+D_{w}x(p,w)x(p,w)^{\top}$
\end_inset

.
\end_layout

\begin_layout Standard
Differentiate the duality identity 
\begin_inset Formula $h(p,\overline{u})=x(p,e(p,\overline{u}))$
\end_inset

 with respect to 
\begin_inset Formula $p$
\end_inset

:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
D_{p}h(p,\overline{u})=D_{p}x(p,e(p,\overline{u}))+D_{w}x(p,e(p,\overline{u}))\nabla_{p}e(p,\overline{u})^{\top}
\]

\end_inset


\end_layout

\begin_layout Standard
By Shephard's lemma and the duality identities,
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
D_{p}h(p,v(p,w))=D_{p}x(p,w)+D_{w}x(p,w)x(p,w)^{\top}=S(p,w).
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Note Note
status collapsed

\begin_layout Plain Layout
ECON803_CONSUMER_RESTRUCTURE_SOURCE:section:consumer-theory-utility-maximization:14:summary-of-the-implications-of-utility-maximization
\end_layout

\end_inset


\end_layout

\begin_layout Section
Workhorse Demand through Duality
\end_layout

\begin_layout Standard
\begin_inset CommandInset label
LatexCommand label
name "sec:workhorse-duality"

\end_inset
\end_layout

\begin_layout Subsection
CES Expenditure, Compensation, and Substitution
\end_layout

\begin_layout Standard
Keep Chapter 1's degree-one CES normalization. Its unit expenditure index \begin_inset Formula $\notationfirst{unit-expenditure-index}{\mathcal P(p)}:=e(p,1)$\end_inset
 records the minimum cost of one unit of that utility index. Substituting the CES demand into utility, and then using duality, gives
\end_layout

\begin_layout Standard
\begin_inset Formula
\[
\mathcal P(p)=\begin{cases}\left(\sum_\ell a_\ell^\sigma p_\ell^{1-\sigma}\right)^{1/(1-\sigma)},&\sigma\ne1,\\ \prod_\ell(p_\ell/a_\ell)^{a_\ell},&\sigma=1,\end{cases}
\]
\end_inset
\end_layout

\begin_layout Standard
\begin_inset Formula
\[
v(p,w)=\frac{w}{\mathcal P(p)},\qquad e(p,\bar u)=\bar u\mathcal P(p),\qquad h_\ell(p,\bar u)=\bar u a_\ell^\sigma p_\ell^{-\sigma}\mathcal P(p)^\sigma.
\]
\end_inset
\end_layout

\begin_layout Standard
Here \begin_inset Formula $\bar u>0$\end_inset
. The Cobb-Douglas factors \begin_inset Formula $a_\ell$\end_inset
 in the unit expenditure formula follow from the chosen utility normalization; omitting them changes the utility units. Marshallian demand itself is unaffected by a positive rescaling of utility. Differentiating Hicksian demand gives own-price elasticity \begin_inset Formula $-\sigma(1-b_\ell)$\end_inset
 and, for \begin_inset Formula $k\ne\ell$\end_inset
, cross-price elasticity \begin_inset Formula $\sigma b_k>0$\end_inset
. CES goods are compensated substitutes even when \begin_inset Formula $\sigma<1$\end_inset
 makes them gross complements at fixed wealth.
\end_layout

\begin_layout Example
Exact compensation after a price increase. With equal weights, \begin_inset Formula $\sigma=2$\end_inset
, \begin_inset Formula $p^0=(1,2)$\end_inset
, and \begin_inset Formula $w=120$\end_inset
, Chapter 1 found \begin_inset Formula $x^0=(80,20)$\end_inset
. Here \begin_inset Formula $\mathcal P(p^0)=8/3$\end_inset
 and initial utility is 45. If \begin_inset Formula $p^1=(2,2)$\end_inset
, then \begin_inset Formula $\mathcal P(p^1)=4$\end_inset
. Maintaining utility 45 requires wealth 180, so compensation is 60 and the compensated bundle is \begin_inset Formula $(45,45)$\end_inset
. At unchanged wealth 120, the final bundle is \begin_inset Formula $(30,30)$\end_inset
. For good 1, the total change \begin_inset Formula $-50$\end_inset
 is the compensated change \begin_inset Formula $-35$\end_inset
 plus the remaining wealth effect \begin_inset Formula $-15$\end_inset
. This is a finite-change Hicks decomposition; the Slutsky equation describes the corresponding local derivative.
\end_layout

\begin_layout Standard
\begin_inset Separator parbreak
\end_inset


\end_layout

\begin_layout Subsection
A Homothetic Translog Expenditure Model
\end_layout

\begin_layout Standard
\begin_inset CommandInset label
LatexCommand label
name "sec:translog-demand"

\end_inset
\end_layout

\begin_layout Standard
The translog family provides a flexible quadratic approximation in logarithms. We use a homothetic expenditure specification; richer translog families also permit wealth-dependent shares. Prices are measured relative to fixed reference units, so each logarithm is dimensionless. Write
\end_layout

\begin_layout Standard
\begin_inset Formula
\[
\log\mathcal P_{\mathrm{TL}}(p)=\alpha_0+\sum_{\ell=1}^{L}\alpha_\ell\log p_\ell+\frac12\sum_{\ell=1}^{L}\sum_{k=1}^{L}\gamma_{\ell k}\log p_\ell\log p_k.
\]
\end_inset
\end_layout

\begin_layout Standard
The intercept is \begin_inset Formula $\alpha_0$\end_inset
, the linear coefficients are \begin_inset Formula $\alpha_\ell$\end_inset
, and the symmetric curvature matrix is \begin_inset Formula $\notationfirst{translog-curvature}{\Gamma}=(\gamma_{\ell k})$\end_inset
. Impose \begin_inset Formula $\sum_\ell\alpha_\ell=1$\end_inset
 and \begin_inset Formula $\Gamma\mathbf1_L=0$\end_inset
. These restrictions make \begin_inset Formula $\mathcal P_{\mathrm{TL}}$\end_inset
 homogeneous of degree one in prices. The matrix \begin_inset Formula $\Gamma$\end_inset
 here is unrelated to the subsistence vector \begin_inset Formula $\gamma$\end_inset
 in Stone-Geary utility. The translog approach originates with Christensen, Jorgenson, and Lau; the expenditure formulation and curvature calculation below also follow Diewert's treatment.
\end_layout

\begin_layout Standard
\begin_inset CommandInset citation
LatexCommand citep
key "christensenjorgensonlau1975,diewert2023"

\end_inset
\end_layout

\begin_layout Standard
Suppose the price region under study is regular, as specified below. With \begin_inset Formula $e(p,\bar u)=\bar u\mathcal P_{\mathrm{TL}}(p)$\end_inset
 and \begin_inset Formula $v(p,w)=w/\mathcal P_{\mathrm{TL}}(p)$\end_inset
, Shephard's lemma gives
\end_layout

\begin_layout Standard
\begin_inset Formula
\[
\begin{aligned}b_\ell(p)&=\frac{\partial\log\mathcal P_{\mathrm{TL}}(p)}{\partial\log p_\ell}=\alpha_\ell+\sum_k\gamma_{\ell k}\log p_k,\\ h_\ell(p,\bar u)&=\frac{\bar u\mathcal P_{\mathrm{TL}}(p)}{p_\ell}b_\ell(p),\qquad x_\ell(p,w)=\frac{w}{p_\ell}b_\ell(p).\end{aligned}
\]
\end_inset
\end_layout

\begin_layout Standard
Adding up and homogeneity follow from the coefficient restrictions, but nonnegative demand and substitution restrictions require more. On an open convex cone \begin_inset Formula $\mathcal D\subseteq\mathbb R_{++}^{L}$\end_inset
, require \begin_inset Formula $b_\ell(p)>0$\end_inset
 and the following matrix to be negative semidefinite at every price in \begin_inset Formula $\mathcal D$\end_inset
:
\end_layout

\begin_layout Standard
\begin_inset Formula
\[
H(p):=\Gamma+\boldsymbol b(p)\boldsymbol b(p)^\top-\operatorname{diag}(\boldsymbol b(p)).
\]
\end_inset
\end_layout

\begin_layout Standard
To see the role of this condition, let \begin_inset Formula $D=\operatorname{diag}(p_1,\ldots,p_L)$\end_inset
. Differentiating \begin_inset Formula $\partial_{p_\ell}\mathcal P_{\mathrm{TL}}=\mathcal P_{\mathrm{TL}}b_\ell/p_\ell$\end_inset
 yields
\end_layout

\begin_layout Standard
\begin_inset Formula
\[
\nabla_p^2\mathcal P_{\mathrm{TL}}(p)=\mathcal P_{\mathrm{TL}}(p)D^{-1}H(p)D^{-1}.
\]
\end_inset
\end_layout

\begin_layout Standard
Thus \begin_inset Formula $H(p)\preceq0$\end_inset
 is exactly the local curvature restriction. Requiring it throughout a convex price domain establishes concavity on that domain. Positive fitted shares alone do not establish rationalizability, and checking curvature at one observation does not justify a distant counterfactual. The Slutsky matrix is \begin_inset Formula $S(p,w)=wD^{-1}H(p)D^{-1}$\end_inset
, so symmetry, negativity, and the zero price direction are explicit.
\end_layout

\begin_layout Standard
There is a direct optimizing model behind these formulas. Define, for \begin_inset Formula $x\in\mathbb R_+^L$\end_inset
,
\end_layout

\begin_layout Standard
\begin_inset Formula
\[
u_{\mathcal D}(x)=\inf_{r\in\mathcal D}\frac{r\cdot x}{\mathcal P_{\mathrm{TL}}(r)}.
\]
\end_inset
\end_layout

\begin_layout Standard
This is a nonnegative, concave, homogeneous, nondecreasing utility. At \begin_inset Formula $p\in\mathcal D$\end_inset
, concavity and homogeneity of the price index imply \begin_inset Formula $r\cdot\nabla\mathcal P_{\mathrm{TL}}(p)\ge\mathcal P_{\mathrm{TL}}(r)$\end_inset
 for every \begin_inset Formula $r\in\mathcal D$\end_inset
, with equality at \begin_inset Formula $r=p$\end_inset
. Hence \begin_inset Formula $u_{\mathcal D}(\nabla\mathcal P_{\mathrm{TL}}(p))=1$\end_inset
. Scaling that bundle attains target utility \begin_inset Formula $\bar u>0$\end_inset
 at expenditure \begin_inset Formula $\bar u\mathcal P_{\mathrm{TL}}(p)$\end_inset
; any bundle reaching the target costs at least that much. This proves the expenditure formula, and therefore the displayed demand, at prices in \begin_inset Formula $\mathcal D$\end_inset
. It does not extend the translog formula to prices outside its regular region.
\end_layout

\begin_layout Standard
The compensated and uncompensated elasticities make the extra flexibility visible. Let \begin_inset Formula $\delta_{\ell k}$\end_inset
 equal one when \begin_inset Formula $\ell=k$\end_inset
 and zero otherwise. Then
\end_layout

\begin_layout Standard
\begin_inset Formula
\[
\frac{\partial\log x_\ell}{\partial\log p_k}=\frac{\gamma_{\ell k}}{b_\ell}-\delta_{\ell k},\qquad \frac{\partial\log h_\ell}{\partial\log p_k}=\frac{\gamma_{\ell k}}{b_\ell}+b_k-\delta_{\ell k}.
\]
\end_inset
\end_layout

\begin_layout Standard
Wealth elasticities are one in this homothetic version, while price elasticities vary with the shares. For two goods, the elasticity of substitution is \begin_inset Formula $1+\gamma_{12}/(b_1b_2)$\end_inset
 on the regular region. With more goods the same expression is the Allen-Uzawa pairwise elasticity, rather than a universal elasticity of every quantity ratio. Setting \begin_inset Formula $\Gamma=0$\end_inset
 recovers constant shares and a Cobb-Douglas price index. General translog utility models need not be homothetic.
\end_layout

\begin_layout Example
A translog model with changing shares. Let \begin_inset Formula $L=2$\end_inset
, \begin_inset Formula $\alpha_0=0$\end_inset
, \begin_inset Formula $\alpha_1=\alpha_2=1/2$\end_inset
, and \begin_inset Formula $\Gamma=\tfrac1{10}\left(\begin{smallmatrix}1&-1\\-1&1\end{smallmatrix}\right)$\end_inset
. Writing \begin_inset Formula $r=p_1/p_2$\end_inset
 gives
\end_layout

\begin_layout Standard
\begin_inset Separator parbreak
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula
\[
\mathcal P_{\mathrm{TL}}(p)=\sqrt{p_1p_2}\exp\!\left(\frac{(\log r)^2}{20}\right),\qquad b_1=\frac12+\frac{\log r}{10},\quad b_2=1-b_1.
\]
\end_inset
\end_layout

\begin_layout Standard
At \begin_inset Formula $p=(1,1)$\end_inset
 and \begin_inset Formula $w=100$\end_inset
, demand is \begin_inset Formula $(50,50)$\end_inset
. At \begin_inset Formula $p=(2,1)$\end_inset
 and the same wealth, shares are approximately \begin_inset Formula $(0.569315,0.430685)$\end_inset
 and demand is \begin_inset Formula $(28.4657,43.0685)$\end_inset
. The first quantity falls while its budget share rises. The substitution elasticity changes from \begin_inset Formula $0.6$\end_inset
 at equal prices to approximately \begin_inset Formula $0.592162$\end_inset
 at \begin_inset Formula $(2,1)$\end_inset
; a single CES elasticity cannot reproduce that variation throughout the region.
\end_layout

\begin_layout Example
Positive shares can conceal invalid curvature. In the preceding model, \begin_inset Formula $H=(1/10-b_1b_2)\left(\begin{smallmatrix}1&-1\\-1&1\end{smallmatrix}\right)$\end_inset
. Shares are positive when \begin_inset Formula $|\log r|<5$\end_inset
, but curvature holds only when \begin_inset Formula $|\log r|\le\sqrt{15}$\end_inset
. Thus \begin_inset Formula $|\log r|<\sqrt{15}$\end_inset
 defines an open convex cone on which the construction above is valid. At \begin_inset Formula $r=\exp(4)$\end_inset
 the shares \begin_inset Formula $(0.9,0.1)$\end_inset
 still look admissible, yet \begin_inset Formula $1/10-b_1b_2=0.01>0$\end_inset
: compensated own-price responses have the wrong sign. This counterfactual must be rejected for this parameterization.
\end_layout

\begin_layout Standard
\begin_inset Separator parbreak
\end_inset


\end_layout

\begin_layout Section
What Utility Maximization Implies
\end_layout

\begin_layout Proposition
Suppose demand 
\begin_inset Formula $x(p,w)$
\end_inset

 is generated by maximizing a complete,
 transitive,
 continuous,
 and locally nonsatiated preference relation represented by 
\begin_inset Formula $u$
\end_inset

 on each linear budget;
 that is,
 
\begin_inset Formula $x(p,w)=\arg\max_{y\in B(p,w)}u(y)$
\end_inset

 for every 
\begin_inset Formula $(p,w)\in\mathsf{P}\times\mathsf{W}$
\end_inset

.
 Then demand satisfies Walras' law and is homogeneous of degree zero.
\end_layout

\begin_layout Proposition
If,
 in addition,
 demand is single-valued and continuously differentiable and the expenditure function is twice continuously differentiable,
 then the Slutsky matrix 
\begin_inset Formula $S(p,w)$
\end_inset

 is symmetric and negative semidefinite,
 and it is singular in the price direction:
 
\begin_inset Formula $S(p,w)p=0$
\end_inset

 for every 
\begin_inset Formula $(p,w)\in\mathsf{P}\times\mathsf{W}$
\end_inset

.
\end_layout

\begin_layout Standard
This proposition summarizes our previous results.
\end_layout

\begin_layout Standard
\begin_inset Note Note
status collapsed

\begin_layout Plain Layout
ECON803_CONSUMER_RESTRUCTURE_SOURCE:section:consumer-theory-utility-maximization:25:welfare-evaluation
\end_layout

\end_inset


\end_layout

\begin_layout Section
Welfare Evaluation
\end_layout

\begin_layout Standard
We will compare the wealth needed to achieve a certain level of utility at a given price-wealth pair.
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
u^{1}=v(p^{1},w)
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
u^{0}=v(p^{0},w).
\]

\end_inset


\end_layout

\begin_layout Standard
We are interested in comparing the expenditure needed to achieve 
\begin_inset Formula $u^{1}$
\end_inset

 or 
\begin_inset Formula $u^{0}$
\end_inset

.
\end_layout

\begin_layout Standard
For a fixed reference price and a given utility level 
\begin_inset Formula $u$
\end_inset

,
 the needed expenditure to reach it is given by
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
e(p^{ref},u).
\]

\end_inset


\end_layout

\begin_layout Standard
Thus the comparison in terms of expenditure is given by
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
e(p^{ref},u^{1})-e(p^{ref},u^{0})
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
e(p^{ref},v(p^{1},w))-e(p^{ref},v(p^{0},w)).
\]

\end_inset


\end_layout

\begin_layout Standard
This expression will be positive when it takes more wealth to achieve 
\begin_inset Formula $u^{1}$
\end_inset

 at prices 
\begin_inset Formula $p^{ref}$
\end_inset

 than to achieve 
\begin_inset Formula $u^{0}$
\end_inset

.
 This difference is measured in dollar terms.
 That is why 
\begin_inset Formula $e(p^{ref},v(p,w))$
\end_inset

 is often called money metric indirect utility function.
\end_layout

\begin_layout Standard
We can construct many money metric indirect utility functions with different reference price.
\end_layout

\begin_layout Standard
 When 
\begin_inset Formula $p^{ref}=p^{0}$
\end_inset

 is the original price situation,
 the expenditure change equals the wealth change that makes the consumer indifferent between the new price with the old wealth and the old price with the new wealth.
 This asks what wealth change is equivalent to the price change.
\end_layout

\begin_layout Standard
Equivalent variation is 
\begin_inset Formula 
\[
\operatorname{EV}(p^{0},p^{1},w)=e(p^{0},v(p^{1},w))-e(p^{0},v(p^{0},w))=e(p^{0},v(p^{1},w))-w,
\]

\end_inset


\end_layout

\begin_layout Standard
since 
\begin_inset Formula $e(p^{0},v(p^{0},w))=w$
\end_inset

.
\end_layout

\begin_layout Standard
With this sign convention,
 equivalent variation is the money change at the reference price that is equivalent to the price change:
 it is willingness to pay for an improvement,
 and its negative is willingness to pay to avoid a worsening.
\end_layout

\begin_layout Standard
The other case considered is the one where the new price is taken as the reference price,
 when 
\begin_inset Formula $p^{ref}=p^{1}$
\end_inset

,
 the expenditure change equals the wealth change that makes the consumer indifferent between the original situation 
\begin_inset Formula $(p^{0},w)$
\end_inset

 and the new situation 
\begin_inset Formula $(p^{1},w+\Delta w)$
\end_inset

.
\end_layout

\begin_layout Standard
Compensating variation is
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\operatorname{CV}(p^{0},p^{1},w)=e(p^{1},v(p^{1},w))-e(p^{1},v(p^{0},w))=w-e(p^{1},v(p^{0},w)).
\]

\end_inset


\end_layout

\begin_layout Standard
The sign convention for compensating variation is analogous:
 a negative value for a worsening is the compensation required to restore the initial utility.
\end_layout


