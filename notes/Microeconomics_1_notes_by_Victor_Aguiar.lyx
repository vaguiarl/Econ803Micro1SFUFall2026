\begin_inset ERT
status open

\begin_layout Plain Layout


\backslash
end{proof}
\end_layout

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Separator parbreak
\end_inset


\end_layout

\begin_layout Standard
We need some definitions.

\end_layout

\begin_layout Definition
Local nonsatiation.
 A preference relation \begin_inset Formula $\succeq$\end_inset
 is locally nonsatiated if, for every \begin_inset Formula $x\in X$\end_inset
 and every \begin_inset Formula $\varepsilon>0$\end_inset
,
 there is \begin_inset Formula $y\in X$\end_inset
 with \begin_inset Formula $\lVert y-x\rVert<\varepsilon$\end_inset
 and \begin_inset Formula $y\succ x$\end_inset
.
\end_layout

\begin_layout Proposition
If a locally nonsatiated utility function generates the Marshallian demand correspondence, then every demanded bundle exhausts the budget: \begin_inset Formula $p\cdot x=w$\end_inset
 for every \begin_inset Formula $x\in x(p,w)$\end_inset
.
\end_layout

\begin_layout Standard
Proof.  If \begin_inset Formula $p\cdot x<w$\end_inset
,
 local nonsatiation supplies a strictly preferred bundle arbitrarily close to \begin_inset Formula $x$\end_inset
.
 For a sufficiently small neighborhood the bundle remains affordable, contradicting utility maximization.  Therefore the budget constraint binds.
\end_layout

\begin_layout Proposition
The same demand correspondence is homogeneous of degree zero.  If preferences are convex, demand is convex-valued; if preferences are strictly convex, demand is single-valued.
\end_layout

\begin_layout Section
KKT Conditions for the UMP
\end_layout

\begin_layout Standard
Assume that 
\begin_inset Formula $u$
\end_inset
 is continuously differentiable and that a constraint qualification holds at the candidate optimum.
 The KKT conditions are then necessary.
 If 
\begin_inset Formula $u$
\end_inset
 is concave, they are also sufficient for a global optimum; differentiability alone does not provide sufficiency.

\end_layout

\begin_layout Standard
The KKT conditions are as follows.
\end_layout

\begin_layout Standard
\begin_inset Formula $\mathcal{L}=u(x)+\lambda(w-p\cdot x)$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\partial_{x_{\ell}}u(x^{*})\leq\lambda^{*}p_{\ell}$
\end_inset

 and 
\begin_inset Formula $x_{\ell}^{*}[\partial_{x_{\ell}}u(x^{*})-\lambda^{*}p_{\ell}]=0$
\end_inset

 for all 
\begin_inset Formula $\ell\in\{1,\ldots,L\}$
\end_inset

.

\end_layout

\begin_layout Standard
\begin_inset Formula $w-p\cdot x^{*}\geq0$
\end_inset

 and 
\begin_inset Formula $\lambda^{*}(w-p\cdot x^{*})=0$
\end_inset

.

\end_layout

\begin_layout Standard
This is a system with 
\begin_inset Formula $L+1$
\end_inset

 unknowns.

\end_layout

\begin_layout Standard
Local nonsatiation implies that the consumer is on the budget hyperplane (the frontier).
 This means that
\end_layout

\begin_layout Standard
\begin_inset Formula
\[
w-p\cdot x^{*}=0.
\]

\end_inset

For an interior solution with a positive multiplier and nonzero marginal utilities,
 the KKT conditions reduce to
\end_layout

\begin_layout Standard
\begin_inset Formula
\[
\frac{\partial_{x_{\ell}}u(x^{*})}{\partial_{x_{k}}u(x^{*})}=\frac{p_{\ell}}{p_{k}}\quad\forall \ell,k\in\{1,\ldots,L\}.
\]

\end_inset


\end_layout

\begin_layout Standard
Note that for 
\begin_inset Formula $L=2$
\end_inset

, 
\begin_inset Formula $-\frac{p_{1}}{p_{2}}$
\end_inset

 is the slope of the budget line and 
\begin_inset Formula $-\frac{\partial_{x_{1}}u(x^{*})}{\partial_{x_{2}}u(x^{*})}$
\end_inset

 is the slope of the indifference curve.
 Their equality is the familiar tangency condition expressed in terms of the marginal rate of substitution (MRS).

\end_layout

\begin_layout Section
Properties of the Indirect Utility Function
\end_layout

\begin_layout Standard
The indirect utility function records the maximum utility attainable from a budget:
\begin_inset Formula
\[
v(p,w)=\max\{u(x):x\in X,\ p\cdot x\leq w\}.
\]

\end_inset
 Thus 
\begin_inset Formula $v:P\times W\to\mathbb{R}$
\end_inset

 ranks price--wealth situations through the utility they permit.

\end_layout

\begin_layout Standard
Alternatively it is the utility evaluated in the Marshallian demand 
\begin_inset Formula $v(p,w)=u(x(p,w))$
\end_inset

.

\end_layout

\begin_layout Proposition
Suppose that 
\begin_inset Formula $u(\cdot)$
\end_inset

 is a continuous utility function representing a locally nonsatiated preference relation 
\begin_inset Formula $\succeq$
\end_inset

 defined on the consumption set 
\begin_inset Formula $X=\mathbb{R}_{+}^{L}$
\end_inset
.
 The indirect utility function 
\begin_inset Formula $v(p,w)$
\end_inset

 is:

\end_layout

\begin_layout Proposition
1.
 Homogeneity of degree zero.

\end_layout

\begin_layout Proposition
2.
 
\begin_inset Formula $v(p,w)$
\end_inset

 is strictly increasing in 
\begin_inset Formula $w$
\end_inset

 and nonincreasing in 
\begin_inset Formula $p_{\ell}$
\end_inset

.

\end_layout

\begin_layout Proposition
3.
 
\begin_inset Formula $v(p,w)$
\end_inset

 is quasiconvex in 
\begin_inset Formula $(p,w)$
\end_inset

.
 The set 
\begin_inset Formula $\{(p,w)|v(p,w)\leq\overline{v}\}$
\end_inset

 is convex.

\end_layout

\begin_layout Proposition
4.
 
\begin_inset Formula $v(p,w)$
\end_inset

 is continuous in 
\begin_inset Formula $p$
\end_inset

 and 
\begin_inset Formula $w$
\end_inset

.

\end_layout

\begin_layout Standard
Proof.  Existence, homogeneity, monotonicity, and continuity follow from the compact budget correspondence and Berge's maximum theorem.
\end_layout

\begin_layout Standard
For quasiconvexity, fix \begin_inset Formula $\overline v$\end_inset
 and let \begin_inset Formula $L_{\overline v}=\{(p,w):v(p,w)\leq\overline v\}$\end_inset
.
 If \begin_inset Formula $u(x)>\overline v$\end_inset
,
 then every \begin_inset Formula $(p,w)\in L_{\overline v}$\end_inset
 must satisfy \begin_inset Formula $p\cdot x>w$\end_inset
,
 because otherwise \begin_inset Formula $x$\end_inset
 would be affordable and the value would exceed \begin_inset Formula $\overline v$\end_inset
.
 Conversely, this strict inequality for every \begin_inset Formula $x$\end_inset
 with \begin_inset Formula $u(x)>\overline v$\end_inset
 rules out an affordable bundle with utility above \begin_inset Formula $\overline v$\end_inset
.
 Hence
\end_layout

\begin_layout Standard
\begin_inset Formula
\[
L_{\overline v}=\bigcap_{u(x)>\overline v}\{(p,w):p\cdot x>w\}.
\]
\end_inset
\end_layout

\begin_layout Standard
Each set in the intersection is a linear half-space in \begin_inset Formula $(p,w)$\end_inset
,
 so the lower contour set is convex and \begin_inset Formula $v$\end_inset
 is quasiconvex.
\end_layout

\begin_layout Section
Roy's Identity
\end_layout

\begin_layout Standard
Recall the definition of indirect utility 
\begin_inset Formula $v(p,w)=u(x(p,w))$
\end_inset

.

\end_layout

\begin_layout Standard
Assume the maximizer is unique and the value function is differentiable.  The envelope theorem applied to
\end_layout

\begin_layout Standard
\begin_inset Formula
\[
v(p,w)=\max_{x\geq0,\;p\cdot x\leq w}u(x)
\]
\end_inset
\end_layout

\begin_layout Standard
gives
\end_layout

\begin_layout Standard
\begin_inset Formula
\[
\partial_w v(p,w)=\lambda(p,w),\qquad \nabla_p v(p,w)=-\lambda(p,w)x(p,w).
\]
\end_inset
\end_layout

\begin_layout Standard
If demand is unique, the envelope derivatives exist, and 
\begin_inset Formula $\partial_w v(p,w)=\lambda(p,w)>0$
\end_inset
, Roy's identity is
\end_layout

\begin_layout Standard
\begin_inset Formula
\[
x(p,w)=-\frac{\nabla_{p}v(p,w)}{\partial_{w}v(p,w)}.
\]

\end_inset


\end_layout

\begin_layout Example
Quasilinear demand and Roy's identity.
 Let good \begin_inset Formula $L$\end_inset
 be the numeraire, set \begin_inset Formula $p_L=1$\end_inset
,
 and let utility be \begin_inset Formula $u(q,q_L)=g(q)+q_L$\end_inset
 for \begin_inset Formula $q\in\mathbb{R}_{+}^{L-1}$\end_inset
.
 Feasibility of the nonnegative numeraire requires 
\begin_inset Formula $p_{-L}\cdot q\leq w$
\end_inset
.
 The indirect utility is
\end_layout

\begin_layout Example
\begin_inset Formula
\[
v(p,w)=w+\max_{q\geq0,\;p_{-L}\cdot q\leq w}\{g(q)-p_{-L}\cdot q\}.
\]
\end_inset
\end_layout

\begin_layout Standard
When the unconstrained maximizer of 
\begin_inset Formula $g(q)-p_{-L}\cdot q$
\end_inset
 is affordable and leaves a nonnegative numeraire, the wealth constraint inside the displayed maximum is slack and non-numeraire demands have no income effects.
 When the maximizer is unique and the envelope theorem applies, Roy's identity gives \begin_inset Formula $x_k(p,w)=-\partial_{p_k}v(p,w)$\end_inset
 for \begin_inset Formula $k<L$\end_inset
,
 and the numeraire demand is the residual \begin_inset Formula $x_L=w-p_{-L}\cdot x_{-L}(p)$\end_inset
.
\end_layout

\begin_layout Section
Expenditure Minimization Problem (EMP)
\end_layout

\begin_layout Standard
At prices 
\begin_inset Formula $p$
\end_inset

, the expenditure minimization problem (EMP) asks for the least expenditure required to attain utility 
\begin_inset Formula $\overline{u}$
\end_inset

:
\begin_inset Formula
\[
e(p,\overline{u})=\min\{p\cdot x:x\in X,\ u(x)\geq\overline{u}\}.
\]

\end_inset
\end_layout

\begin_layout Proposition
Suppose 
\begin_inset Formula $u$
\end_inset

 is a continuous utility function representing a locally nonsatiated preference relation 
\begin_inset Formula $\succeq$
\end_inset

 defined on the consumption set 
\begin_inset Formula $X=\mathbb{R}_{+}^{L}$
\end_inset

 and the price vector is 
\begin_inset Formula $p\gg0$
\end_inset

.
 Then:

\end_layout

\begin_layout Proposition
(i) If 
\begin_inset Formula $x^{*}$
\end_inset

 is optimal in the UMP when 
\begin_inset Formula $w>0$
\end_inset

 then 
\begin_inset Formula $x^{*}$
\end_inset

 is optimal in the EMP when the required level of utility is 
\begin_inset Formula $u(x^{*})$
\end_inset

.
 Moreover,
 the minimized expenditure level 
\begin_inset Formula $p\cdot x^{*}=w$
\end_inset

 is exactly the wealth 
\begin_inset Formula $w$
\end_inset

.
\end_layout

\begin_layout Proposition
(ii) If 
\begin_inset Formula $x^{*}$
\end_inset

 is optimal in the EMP when the required utility level is 
\begin_inset Formula $\overline{u}>u(0)$
\end_inset

 then 
\begin_inset Formula $x^{*}$
\end_inset

 is optimal in the UMP when wealth is 
\begin_inset Formula $p\cdot x^{*}$
\end_inset

.
 Moreover,
 the maximized utility level 
\begin_inset Formula $u(x^{*})=\overline{u}$
\end_inset
.

\end_layout

\begin_layout Standard
The proof uses local nonsatiation to show that both constraints bind and then applies the definitions of the two optimization problems.

\end_layout

\begin_layout Standard

\series bold
Expenditure function
\series default
.
 The function 
\begin_inset Formula $e(p,\overline{u})$
\end_inset

 is the value of the EMP.
 Whenever a solution exists, 
\begin_inset Formula $e(p,\overline{u})=p\cdot x^{*}$
\end_inset

 for every expenditure-minimizing bundle 
\begin_inset Formula $x^{*}$
\end_inset
.

\end_layout

\begin_layout Proposition
Suppose that 
\begin_inset Formula $u$
\end_inset

 is a continuous utility function representing a locally nonsatiated preference relation 
\begin_inset Formula $\succeq$
\end_inset

 defined on the consumption set 
\begin_inset Formula $X=\mathbb{R}_{+}^{L}$
\end_inset
, with 
\begin_inset Formula $p\in\mathbb{R}_{++}^{L}$
\end_inset
 and the target utility in the attainable range.
 The expenditure 
\begin_inset Formula $e(p,\overline{u})$
\end_inset

 is
\end_layout

\begin_layout Proposition
(i) Homogeneous of degree one in 
\begin_inset Formula $p$
\end_inset

.
\end_layout

\begin_layout Proposition
(ii) Nondecreasing in 
\begin_inset Formula $\overline{u}$
\end_inset

 and nondecreasing in 
\begin_inset Formula $p_{\ell}$
\end_inset

 for all 
\begin_inset Formula $\ell$
\end_inset
.
 Strict increase in the utility target requires restricting attention to targets above the baseline utility and conditions ensuring that the minimum reaches the target exactly.
\end_layout

\begin_layout Proposition
(iii) Concave in 
\begin_inset Formula $p$
\end_inset


\end_layout

\begin_layout Proposition
(iv) Continuous in 
\begin_inset Formula $(p,\overline{u})$
\end_inset

.

\end_layout

\begin_layout Standard
\begin_inset Separator parbreak
\end_inset


\end_layout

\begin_layout Standard
\begin_inset ERT
status open

\begin_layout Plain Layout


\backslash
begin{proof}
\end_layout

\end_inset


\end_layout

\begin_layout Standard
(i) Multiplying every price by 
\begin_inset Formula $\alpha>0$
\end_inset

 does not change the feasible set and multiplies the objective by 
\begin_inset Formula $\alpha$
\end_inset
; hence 
\begin_inset Formula $e(\alpha p,\overline{u})=\alpha e(p,\overline{u})$
\end_inset
.
 For (ii), increasing the utility target shrinks the feasible set, while increasing a price cannot reduce the expenditure on any fixed nonnegative bundle.

\end_layout

\begin_layout Standard
(iii) Let 
\begin_inset Formula $p^{\alpha}=\alpha p+(1-\alpha)p'$
\end_inset

 with 
\begin_inset Formula $\alpha\in[0,1]$
\end_inset

 and choose any 
\begin_inset Formula $x^{\alpha}\in h(p^{\alpha},\overline{u})$
\end_inset
.
 Feasibility of 
\begin_inset Formula $x^{\alpha}$
\end_inset

 at each price vector gives
\begin_inset Formula
\[
\begin{aligned}
e(p^{\alpha},\overline{u})
&=\alpha p\cdot x^{\alpha}+(1-\alpha)p'\cdot x^{\alpha}\\
&\geq \alpha e(p,\overline{u})+(1-\alpha)e(p',\overline{u}).
\end{aligned}
\]

\end_inset
 Hence the expenditure function is concave in prices.
\end_layout

\begin_layout Standard
(iv) Continuity in 
\begin_inset Formula $(p,\overline{u})$
\end_inset

.
\end_layout

\begin_layout Standard
Continuity follows from the standard expenditure-function theorem.
 The unbounded feasible set cannot be inserted directly into Berge's theorem.
 Instead, around any 
\begin_inset Formula $(p,\overline{u})$
\end_inset
 with strictly positive prices, one first obtains a common expenditure upper bound from one feasible bundle.
 Strict positivity of nearby prices then confines every optimizer to a common compact box.
 Berge's theorem applies to this locally compactified problem.
 Continuity of preferences and local nonsatiation ensure feasibility stability and that an optimum reaches the target utility.

\end_layout

\begin_layout Standard
\begin_inset ERT
status open

\begin_layout Plain Layout


\backslash
end{proof}
\end_layout

\end_inset


\end_layout

\begin_layout Section
Hicksian Compensated Demand
\end_layout

\begin_layout Standard
The Hicksian (compensated) demand correspondence is the solution set of the EMP: 
\begin_inset Formula $h(p,\overline{u})=\arg\min\{p\cdot x:x\in X,\ u(x)\geq\overline{u}\}$
\end_inset

.

\end_layout

\begin_layout Proposition
Suppose 
\begin_inset Formula $u(\cdot)$
\end_inset

 is continuous and represents a locally nonsatiated preference relation 
\begin_inset Formula $\succeq$
\end_inset

, prices satisfy 
\begin_inset Formula $p\gg0$
\end_inset
, and the attainable target satisfies 
\begin_inset Formula $\overline{u}>u(0)$
\end_inset
.
 Then 
\begin_inset Formula $h(p,\overline{u})$
\end_inset

 is nonempty and compact-valued and has the following properties:
\end_layout

\begin_layout Proposition
(i) It is homogeneous of degree zero in 
\begin_inset Formula $p$
\end_inset


\end_layout

\begin_layout Proposition
(ii) It has no excess utility:
 For 
\begin_inset Formula $x^{*}\in h(p,\overline{u})$
\end_inset

,
 
\begin_inset Formula $u(x^{*})=\overline{u}$
\end_inset


\end_layout

\begin_layout Proposition
(iii) Convexity and uniqueness:
 If 
\begin_inset Formula $\succeq$
\end_inset

 is convex,
 then 
\begin_inset Formula $h(p,\overline{u})$
\end_inset

 is convex;
 if 
\begin_inset Formula $\succeq$
\end_inset

 is strictly convex,
 then Hicksian demand is single-valued.

\end_layout

\begin_layout Section
KKT Conditions for the EMP
\end_layout

\begin_layout Standard
Assume 
\begin_inset Formula $u$
\end_inset

 is continuously differentiable and a constraint qualification holds at the candidate optimum.
 The KKT conditions below are necessary.
 If 
\begin_inset Formula $u$
\end_inset

 is concave, they are also sufficient.

\end_layout

\begin_layout Standard
The Lagrangian for this problem is:
\end_layout

\begin_layout Standard
\begin_inset Formula
\[
\mathcal{L}_{\mathrm{EMP}}=p\cdot x-\lambda(u(x)-\overline{u}).
\]

\end_inset


\end_layout

\begin_layout Standard
Stationarity and complementary slackness for the nonnegativity constraints give
\end_layout

\begin_layout Standard
\begin_inset Formula
\[
p\geq\lambda\nabla_{x}u(x^{*})
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula
\[
x_{\ell}^{*}[p_{\ell}-\lambda\nabla u(x^{*})_{\ell}]=0,
\]

\end_inset


\end_layout

\begin_layout Standard
for some 
\begin_inset Formula $\lambda\geq0$
\end_inset
,
 together with primal feasibility 
\begin_inset Formula $x^*\geq0$
\end_inset
 and 
\begin_inset Formula $u(x^*)\geq\overline{u}$
\end_inset
,
 and complementary slackness 
\begin_inset Formula $\lambda[u(x^*)-\overline{u}]=0$
\end_inset
.

\end_layout

\begin_layout Section
Shephard's Lemma
\end_layout

\begin_layout Proposition
Every Hicksian bundle is a supergradient of the concave expenditure function in prices.
 If 
\begin_inset Formula $e(\cdot,\overline{u})$
\end_inset
 is differentiable at 
\begin_inset Formula $p$
\end_inset
, Hicksian demand is unique there and Shephard's identity holds:
\begin_inset Formula
\[
\nabla_{p}e(p,\overline{u})=h(p,\overline{u}).
\]

\end_inset
\end_layout

\begin_layout Standard
\begin_inset ERT
status open

\begin_layout Plain Layout


\backslash
begin{proof}
\end_layout

\end_inset


\end_layout

\begin_layout Standard
Fix 
\begin_inset Formula $x^{h}\in h(p,\overline{u})$
\end_inset
.
 For every other price vector 
\begin_inset Formula $p'$
\end_inset
, the same bundle remains feasible, so
\begin_inset Formula
\[
e(p',\overline{u})\leq p'\cdot x^{h}
=e(p,\overline{u})+(p'-p)\cdot x^{h}.
\]

\end_inset
 Hence 
\begin_inset Formula $x^{h}$
\end_inset

 is a supergradient of the concave function 
\begin_inset Formula $e(\cdot,\overline{u})$
\end_inset
.
 At a differentiability point the superdifferential is the singleton 
\begin_inset Formula $\{\nabla_{p}e(p,\overline{u})\}$
\end_inset
, so every Hicksian bundle equals that gradient and demand is unique.
\end_layout

\begin_layout Standard
\begin_inset ERT
status open

\begin_layout Plain Layout


\backslash
end{proof}
\end_layout

\end_inset


\end_layout

\begin_layout Section
Additional Properties
\end_layout

\begin_layout Standard
Assume throughout this subsection that 
\begin_inset Formula $e(\cdot,\overline{u})$
\end_inset
 is twice continuously differentiable, so Hicksian demand is single-valued and differentiable.
 The Jacobian 
\begin_inset Formula $D_{p}h(p,\overline{u})$
\end_inset

 has entries 
\begin_inset Formula $[D_{p}h(p,\overline{u})]_{k\ell}=\partial_{p_{\ell}}h_{k}(p,\overline{u})$
\end_inset
.
\end_layout

\begin_layout Proposition
The Hicksian price-effect matrix satisfies
\begin_inset Formula
\[
D_{p}h(p,\overline{u})=D_{p}^{2}e(p,\overline{u}).
\]

\end_inset
 It is symmetric and negative semidefinite, and 
\begin_inset Formula $D_{p}h(p,\overline{u})p=0$
\end_inset
.
 The first claims follow from Shephard's identity, twice continuous differentiability, and concavity of the expenditure function.
 The last follows by differentiating the degree-zero homogeneity of Hicksian demand.

\end_layout

\begin_layout Definition
Negative semidefiniteness.
 A symmetric 
\begin_inset Formula $L\times L$
\end_inset

 matrix 
\begin_inset Formula $A$
\end_inset

 is negative semidefinite if 
\begin_inset Formula $v^{\top}Av\leq0$
\end_inset

 for every vector 
\begin_inset Formula $v\in\mathbb{R}^{L}$
\end_inset
.

\end_layout

\begin_layout Standard
\begin_inset Separator plain
\end_inset


\end_layout

\begin_layout Example
The following matrix is NSD:
\end_layout

\begin_layout Example
\begin_inset Formula
\[
A=\left[\begin{array}{cc}
-2 & 0\\
0 & 0
\end{array}\right]
\]

\end_inset


\end_layout

\begin_layout Example
\begin_inset Formula
\[
v^{\top}Av=-2v_{1}^{2}\leq0
\]

\end_inset

 for any 
\begin_inset Formula $v\in\mathbb{R}^{2}$
\end_inset

.

\end_layout

\begin_layout Section
Summary of Relationships between the EMP and UMP
\end_layout

\begin_layout Standard
The expenditure function is the value of the EMP: for every 
\begin_inset Formula $x^{h}\in h(p,\overline{u})$
\end_inset
, 
\begin_inset Formula $e(p,\overline{u})=p\cdot x^{h}$
\end_inset
.

\end_layout

\begin_layout Standard
Under continuity and local nonsatiation, at positive prices and feasible utility targets, the demand and value functions satisfy the duality identities

\end_layout

\begin_layout Standard
\begin_inset Formula
\[
\begin{aligned}
h(p,v(p,w))&=x(p,w),\\
x(p,e(p,\overline{u}))&=h(p,\overline{u}),\\
v(p,e(p,\overline{u}))&=\overline{u},\\
e(p,v(p,w))&=w.
\end{aligned}
\]

\end_inset
 The first two equalities are equalities of correspondences; when demand is single-valued, the same notation denotes functions.
\end_layout

\begin_layout Section
Slutsky Equation
\end_layout

\begin_layout Standard
Assume in this section that Marshallian and Hicksian demands are single-valued and continuously differentiable and that the expenditure function is differentiable in prices.
 The Slutsky matrix is 
\begin_inset Formula $S:P\times W\to\mathbb{R}^{L\times L}$
\end_inset

,
 
\begin_inset Formula $S(p,w)_{\ell,k}=\partial_{p_{k}}x_{\ell}(p,w)+\partial_{w}x_{\ell}(p,w)x_{k}(p,w)$
\end_inset

,
 
\begin_inset Formula $S(p,w)=D_{p}x(p,w)+D_{w}x(p,w)x(p,w)^{\top}$
\end_inset

.

\end_layout

\begin_layout Standard
Differentiate the duality identity 
\begin_inset Formula $h(p,\overline{u})=x(p,e(p,\overline{u}))$
\end_inset

 with respect to 
\begin_inset Formula $p$
\end_inset
:

\end_layout

\begin_layout Standard
\begin_inset Formula
\[
D_{p}h(p,\overline{u})=D_{p}x(p,e(p,\overline{u}))+D_{w}x(p,e(p,\overline{u}))\nabla_{p}e(p,\overline{u})^{\top}
\]

\end_inset


\end_layout

\begin_layout Standard
By Shephard's lemma and the duality identities,
\end_layout

\begin_layout Standard
\begin_inset Formula
\[
D_{p}h(p,v(p,w))=D_{p}x(p,w)+D_{w}x(p,w)x(p,w)^{\top}=S(p,w).
\]

\end_inset


\end_layout

\begin_layout Section
Summary of the Implications of Utility Maximization
\end_layout

\begin_layout Proposition
Suppose demand 
\begin_inset Formula $x(p,w)$
\end_inset

 is generated by maximizing a complete, transitive, continuous, and locally nonsatiated preference relation represented by 
\begin_inset Formula $u$
\end_inset

 on each linear budget; that is, 
\begin_inset Formula $x(p,w)\in\arg\max_{y\in B(p,w)}u(y)$
\end_inset

 for every 
\begin_inset Formula $(p,w)\in P\times W$
\end_inset
.
 Then demand satisfies Walras' law and is homogeneous of degree zero.

\end_layout

\begin_layout Proposition
If, in addition, demand is single-valued and continuously differentiable and the expenditure function is twice continuously differentiable, then the Slutsky matrix 
\begin_inset Formula $S(p,w)$
\end_inset

 is symmetric and negative semidefinite, and it is singular in the price direction: 
\begin_inset Formula $S(p,w)p=0$
\end_inset
 for every 
\begin_inset Formula $(p,w)\in P\times W$
\end_inset

.

\end_layout

\begin_layout Standard
This proposition summarizes our previous results.

\end_layout

\begin_layout Section
Integrability
\end_layout

\begin_layout Standard
We now ask for sufficient conditions under which an observed demand function is generated by utility maximization.
 In the abstract choice setting,
 WARP and GARP restrict rationalizability.
 Competitive budget sets are a smaller domain than arbitrary menus,
 so differentiable demand requires additional restrictions.
 The relevant restrictions are stated in terms of the Slutsky matrix.

\end_layout

\begin_layout Standard
Assume throughout this subsection that the demand function 
\begin_inset Formula $x$
\end_inset

 is continuously differentiable.

\end_layout

\begin_layout Standard
Recall that the Slutsky matrix function is 
\begin_inset Formula $S(p,w)=D_{p}x(p,w)+D_{w}x(p,w)x(p,w)^{\top}$
\end_inset

,
 or in the scalar version 
\begin_inset Formula $s_{ij}(p,w)=\partial_{p_{j}}x_{i}(p,w)+\partial_{w}x_{i}(p,w)x_{j}(p,w)$
\end_inset

 for all 
\begin_inset Formula $i,j\in\{1,\ldots,L\}$
\end_inset

.

\end_layout

\begin_layout Remark
Integrability roadmap.
 On an open domain, Walras' law, homogeneity, and a symmetric negative-semidefinite Slutsky matrix are the central differential restrictions.
 They are necessary for every regular utility-generated demand.
 A sufficiency theorem additionally specifies rank or nondegeneracy conditions, the topology of the price-wealth domain, and boundary behavior for the associated differential system.
 Because alternative integrability theorems impose different global hypotheses, this text does not present the preceding checklist as a stand-alone global theorem; applications must cite and verify a precise version.
\end_layout

\begin_layout Standard
The qualifications are essential.  Symmetry and negative semidefiniteness alone, stated on an unspecified domain, do not guarantee a global representation: one must control the domain, boundary behavior, and the differential equation's existence and uniqueness.  Conversely, every continuously differentiable demand generated by a regular locally nonsatiated utility satisfies Walras' law, homogeneity, symmetry, and negative semidefiniteness of the Slutsky matrix.
\end_layout

\begin_layout Remark*
Some textbooks require a boundedness condition on the elasticity of wealth,
 this is in general not required.

\end_layout

\begin_layout Section
Examples and Applications of Demand Integrability
\end_layout

\begin_layout Standard
There are two commodities 
\begin_inset Formula $L=2$
\end_inset

 and you estimate a demand function 
\begin_inset Formula $x_{1}(p,w)=\frac{\alpha w}{p_{1}}$
\end_inset

,
 and you know that the demand of good two is given as a residual.
 Furthermore,
 we have checked that this demand has a Slutsky matrix that is symmetric,
 NSD and singular in prices,
 we normalize 
\begin_inset Formula $p_{2}=1$
\end_inset

.
 Thus 
\begin_inset Formula $x_{2}=(1-\alpha)w.$
\end_inset


\end_layout

\begin_layout Standard
The 
\begin_inset Formula $L-1$
\end_inset

 differential equation is:
\end_layout

\begin_layout Standard
\begin_inset Formula
\[
\mu'(p_{1},1)=\frac{\alpha\mu(p_{1},1)}{p_{1}}=x_{1}((p_{1},1),\mu((p_{1},1))),
\]

\end_inset


\end_layout

\begin_layout Standard
for short,
 we can write:
\end_layout

\begin_layout Standard
\begin_inset Formula
\[
\mu'(p_{1})=\frac{\alpha\mu(p_{1})}{p_{1}}=x_{1}(p_{1},\mu(p_{1})),
\]

\end_inset


\end_layout

\begin_layout Standard
We can write more simply:
\end_layout

\begin_layout Standard
\begin_inset Formula
\[
\frac{\mu'}{\mu}=\frac{\alpha}{p_{1}}.
\]

\end_inset


\end_layout

\begin_layout Standard
Simple integration provides a family of solutions:
\end_layout

\begin_layout Standard
\begin_inset Formula
\[
\ln\mu=\alpha\ln p_{1}+C,
\]

\end_inset


\end_layout

\begin_layout Standard
and in levels:
\end_layout

\begin_layout Standard
\begin_inset Formula
\[
\mu=Kp_{1}^{\alpha},
\]

\end_inset


\end_layout

\begin_layout Standard
with 
\begin_inset Formula $K=\exp(C)$
\end_inset

 a constant of integration.

\end_layout

\begin_layout Standard
Given some initial conditions 
\begin_inset Formula $(p_{1}^{0},w^{0})$
\end_inset

,
 we must have:
\end_layout

\begin_layout Standard
\begin_inset Formula
\[
w^{0}=K(p_{1}^{0})^{\alpha},\quad K=\frac{w^{0}}{(p_{1}^{0})^{\alpha}},
\]

\end_inset


\end_layout

\begin_layout Standard
or
\end_layout

\begin_layout Standard
\begin_inset Formula
\[
\mu(p_{1}^{*};p_{1}^{0},w^{0})=\frac{w^{0}}{(p_{1}^{0})^{\alpha}}(p_{1}^{*})^{\alpha}.
\]

\end_inset


\end_layout

\begin_layout Standard
Normalize 
\begin_inset Formula $p_{1}^{*}=1$
\end_inset
 and define the indirect utility by
\end_layout

\begin_layout Standard
\begin_inset Formula
\[
v(p_{1},w)=\mu(p^{*},p_{1},w)=\frac{w}{p_{1}^{\alpha}}.
\]

\end_inset


\end_layout

\begin_layout Standard
To recover the utility 
\begin_inset Formula $u$
\end_inset

,
 we need to invert the demand,
 note that our primitive is indeed invertible.

\end_layout

\begin_layout Standard
We have to use the demand function and obtain the inverse demand:
\end_layout

\begin_layout Standard
\begin_inset Formula
\[
x_{1}(p,w)=\frac{\alpha w}{p_{1}};\quad x_{2}(p,w)=(1-\alpha)w
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula
\[
\frac{x_{1}}{x_{2}}=\frac{\alpha}{(1-\alpha)}\frac{1}{p_{1}}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula
\[
p_{1}=\frac{\alpha}{1-\alpha}\frac{x_{2}}{x_{1}},\quad w=\frac{x_{2}}{1-\alpha}.
\]

\end_inset


\end_layout

\begin_layout Standard
Replacing back in the indirect utility we have:
\end_layout

\begin_layout Standard
\begin_inset Formula
\[
u(x_{1},x_{2})=v\circ(p_{1},w)(x_{1},x_{2})=v(\frac{\alpha}{1-\alpha}\frac{x_{2}}{x_{1}},\frac{x_{2}}{1-\alpha}).
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula
\[
u(x_{1},x_{2})=\frac{\frac{x_{2}}{1-\alpha}}{\left(\frac{\alpha}{1-\alpha}\frac{x_{2}}{x_{1}}\right)^{\alpha}}=\left(\frac{x_{2}}{1-\alpha}\right)^{1-\alpha}\left(\frac{x_{1}}{\alpha}\right)^{\alpha}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula
\[
u(x_{1},x_{2})=\hat{c}x_{1}^{\alpha}x_{2}^{1-\alpha},\quad
\hat{c}=\frac{1}{\alpha^{\alpha}(1-\alpha)^{1-\alpha}}.
\]

\end_inset


\end_layout

\begin_layout Standard
This is a Cobb-Douglas utility function.

\end_layout

\begin_layout Section
Generalized Axiom of Revealed Preference (GARP)
\end_layout

\begin_layout Standard
We now move from unrestricted demand functions to finite observations.
 Suppose that the dataset is 
\begin_inset Formula $\mathcal{O}=\{(p^{t},x^{t})\}_{t=1}^{T}$
\end_inset

,
 
\begin_inset Formula $T\geq2$
\end_inset

.
 Walras' law is maintained throughout this section.

\end_layout

\begin_layout Definition
The observed bundle 
\begin_inset Formula $x^{t}$
\end_inset

 is directly revealed preferred to 
\begin_inset Formula $x$
\end_inset

,
 written 
\begin_inset Formula $x^{t}R^{D}x$
\end_inset

, if and only if 
\begin_inset Formula $p^{t}\cdot x^{t}\geq p^{t}\cdot x$
\end_inset

.

\end_layout

\begin_layout Definition
The observed bundle 
\begin_inset Formula $x^{t}$
\end_inset

 is indirectly revealed preferred to 
\begin_inset Formula $x$
\end_inset

, written 
\begin_inset Formula $x^{t}Rx$
\end_inset

,
 if and only if there exist 
\begin_inset Formula $m\geq1$
\end_inset

 and bundles 
\begin_inset Formula $z^{0},\ldots,z^{m}$
\end_inset

 such that 
\begin_inset Formula $z^{0}=x^{t}$
\end_inset
, 
\begin_inset Formula $z^{m}=x$
\end_inset
, each 
\begin_inset Formula $z^{k-1}$
\end_inset

 is an observed bundle, and 
\begin_inset Formula $z^{k-1}R^{D}z^{k}$
\end_inset
 for every 
\begin_inset Formula $k=1,\ldots,m$
\end_inset
.
 Thus 
\begin_inset Formula $R$
\end_inset

 is the transitive closure of 
\begin_inset Formula $R^{D}$
\end_inset
 on the observed data.

\end_layout

\begin_layout Standard
Utility maximization can be set-valued, so repeated observations of the same budget may contain different maximizing bundles.
 The relevant empirical notion is therefore weak rationalization.

\end_layout

\begin_layout Definition
We say that a utility function 
\begin_inset Formula $u$
\end_inset

 (weakly) rationalizes a dataset 
\begin_inset Formula $\mathcal{O}$
\end_inset

 if, for every 
\begin_inset Formula $t\in\{1,\ldots,T\}$
\end_inset

 and every 
\begin_inset Formula $x\in X$
\end_inset

, 
\begin_inset Formula $p^{t}\cdot x\leq p^{t}\cdot x^{t}$
\end_inset

 implies 
\begin_inset Formula $u(x^{t})\geq u(x)$
\end_inset

.

\end_layout

\begin_layout Standard
We now introduce a property that serves as a test of rationalizability.
 We can define the strict direct preference relation as 
\begin_inset Formula $x^{t}P^{D}x^{s}$
\end_inset

 if and only if 
\begin_inset Formula $p^{t}\cdot x^{t}>p^{t}\cdot x^{s}$
\end_inset


\end_layout

\begin_layout Definition
A finite demand dataset 
\begin_inset Formula $\mathcal{O}=\{(p^{t},x^{t})\}_{t=1}^{T}$
\end_inset

 satisfies the generalized axiom of revealed preference (GARP) if
\begin_inset Formula
\[
x^{t}Rx^{s}\quad\Longrightarrow\quad\neg\bigl(x^{s}P^{D}x^{t}\bigr)
\]

\end_inset

for all observations 
\begin_inset Formula $s,t$
\end_inset

, where 
\begin_inset Formula $R$
\end_inset

 is the transitive closure of direct revealed preference and
\begin_inset Formula
\[
x^{s}P^{D}x^{t}\iff p^{s}\cdot x^{s}>p^{s}\cdot x^{t}.
\]

\end_inset

Equivalently, a chain of weak revealed-preference comparisons may not be closed by a strict direct comparison in the opposite direction.
\end_layout

\begin_layout Proposition
(Afriat's theorem.) Let 
\begin_inset Formula $\mathcal{O}=\{(p^{t},x^{t})\}_{t=1}^{T}$
\end_inset

 be a finite dataset with 
\begin_inset Formula $p^{t}\gg0$
\end_inset

 and 
\begin_inset Formula $x^{t}\in\mathbb{R}_{+}^{L}$
\end_inset

 for every observation 
\begin_inset Formula $t$
\end_inset
.
 The following are equivalent:
\end_layout

\begin_layout Proposition
1.
 There exists a locally nonsatiated utility function 
\begin_inset Formula $u$
\end_inset

 that rationalizes the data in the sense that for all 
\begin_inset Formula $t$
\end_inset

,
 
\begin_inset Formula $u(x^{t})\geq u(x)$
\end_inset

 for all 
\begin_inset Formula $x$
\end_inset

 such that 
\begin_inset Formula $p^{t}\cdot x^{t}\geq p^{t}\cdot x$
\end_inset

.

\end_layout

\begin_layout Proposition
2.
 The dataset 
\begin_inset Formula $\mathcal{O}=\{(p^{t},x^{t})\}_{t=1}^{T}$
\end_inset

 satisfies GARP.

\end_layout

\begin_layout Proposition
3.
 There exist numbers 
\begin_inset Formula $u^{t}\in\mathbb{R}$
\end_inset

 and 
\begin_inset Formula $\lambda^{t}>0$
\end_inset

 satisfying the Afriat inequalities
\end_layout

\begin_layout Proposition
\begin_inset Formula
\[
u^{t}\leq u^{s}+\lambda^{s}p^{s}\cdot (x^{t}-x^{s})\quad\forall s,t\in\{1,\ldots,T\}
\]

\end_inset


\end_layout

\begin_layout Proposition
4.
 There exists a continuous, concave, and strictly increasing utility function 
\begin_inset Formula $u$
\end_inset

 that rationalizes the data in the sense that for all 
\begin_inset Formula $t$
\end_inset

,
 
\begin_inset Formula $u(x^{t})\geq u(x)$
\end_inset

 for all 
\begin_inset Formula $x$
\end_inset

 such that 
\begin_inset Formula $p^{t}\cdot x^{t}\geq p^{t}\cdot x$
\end_inset

.

\end_layout

\begin_layout Standard
\begin_inset ERT
status open

\begin_layout Plain Layout


\backslash
begin{proof}
\end_layout

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $(1)\implies(2),(2)\implies(3),(3)\implies(4),(4)\implies(1)$
\end_inset

.
\end_layout

\begin_layout Standard
(
\begin_inset Formula $1$
\end_inset

) implies (2),

\end_layout

\begin_layout Standard
Assume that 
\begin_inset Formula $\mathcal{O}$
\end_inset

 is rationalized by a locally nonsatiated utility function and suppose, toward a contradiction, that GARP fails.
 Then there are observation indices 
\begin_inset Formula $t_{0},\ldots,t_{m}$
\end_inset

 such that 
\begin_inset Formula $x^{t_{k-1}}R^{D}x^{t_{k}}$
\end_inset

 for 
\begin_inset Formula $k=1,\ldots,m$
\end_inset

 and 
\begin_inset Formula $x^{t_{m}}P^{D}x^{t_{0}}$
\end_inset
.
 Rationalization gives 
\begin_inset Formula $u(x^{t_{0}})\geq\cdots\geq u(x^{t_{m}})$
\end_inset
.
 The strict comparison implies 
\begin_inset Formula $p^{t_{m}}\cdot x^{t_{0}}<p^{t_{m}}\cdot x^{t_{m}}$
\end_inset
.
 By local nonsatiation, there is a bundle 
\begin_inset Formula $y$
\end_inset

 with 
\begin_inset Formula $\lVert y-x^{t_{0}}\rVert<\varepsilon$
\end_inset

 and 
\begin_inset Formula $u(y)>u(x^{t_{0}})$
\end_inset
; choosing 
\begin_inset Formula $\varepsilon>0$
\end_inset

 sufficiently small preserves strict affordability at prices 
\begin_inset Formula $p^{t_{m}}$
\end_inset
.
 Thus 
\begin_inset Formula $y$
\end_inset

 is affordable at observation 
\begin_inset Formula $t_m$
\end_inset

 and satisfies 
\begin_inset Formula $u(y)>u(x^{t_m})$
\end_inset
, contradicting rationalization.

\end_layout

\begin_layout Standard
\begin_inset Formula $(2)$
\end_inset

 implies 
\begin_inset Formula $(3)$
\end_inset


\end_layout

\begin_layout Standard
The implication from GARP to the Afriat inequalities is the finite Afriat feasibility lemma.
 It is a theorem of alternatives for the displayed linear system, not an immediate consequence of naming Farkas' lemma.
 We cite the lemma here: for a finite, expenditure-exhausting dataset with strictly positive prices, GARP holds if and only if there exist 
\begin_inset Formula $(u^{1},\ldots,u^{T})$
\end_inset
 and positive 
\begin_inset Formula $(\lambda^{1},\ldots,\lambda^{T})$
\end_inset
 satisfying every Afriat inequality.
 The converse can be seen directly by summing the inequalities around a revealed-preference cycle; the forward direction uses the full finite feasibility lemma.
\end_layout

\begin_layout Standard
\begin_inset Formula $(3)$
\end_inset

 implies 
\begin_inset Formula $(4)$
\end_inset


\end_layout

\begin_layout Standard
Let 
\begin_inset Formula $u(x)=\min_{t\in\{1,\ldots,T\}}\{u^{t}+\lambda^{t}p^{t}\cdot (x-x^{t})\}$
\end_inset

.
 As the pointwise minimum of finitely many affine functions, 
\begin_inset Formula $u$
\end_inset

 is continuous and concave.
 It is strictly increasing in the product order because 
\begin_inset Formula $\lambda^{t}>0$
\end_inset

 and 
\begin_inset Formula $p^{t}\gg0$
\end_inset

 for every observation 
\begin_inset Formula $t$
\end_inset
.

\end_layout

\begin_layout Standard
To verify rationalization, first observe that 
\begin_inset Formula $u(x^{t})=u^{t}$
\end_inset

 for every observation 
\begin_inset Formula $t$
\end_inset

.
 Indeed, the Afriat inequality gives
\begin_inset Formula
\[
u^{t}\leq u^{m}+\lambda^{m}p^{m}\cdot(x^{t}-x^{m})
\]

\end_inset

for every 
\begin_inset Formula $m$
\end_inset

, while the term with 
\begin_inset Formula $m=t$
\end_inset

 equals 
\begin_inset Formula $u^{t}$
\end_inset

.
 Therefore the minimum of these affine terms is exactly 
\begin_inset Formula $u^{t}$
\end_inset

.
\end_layout

\begin_layout Standard
It remains to show that 
\begin_inset Formula $u(x)\leq u(x^{s})$
\end_inset

,
 if 
\begin_inset Formula $p^{s}\cdot x^{s}\geq p^{s}\cdot x$
\end_inset


\end_layout

\begin_layout Standard
If 
\begin_inset Formula $p^{s}\cdot x^{s}\geq p^{s}\cdot x$
\end_inset

,
 or 
\begin_inset Formula $p^{s}\cdot (x^{s}-x)\geq0$
\end_inset

,
 then 
\begin_inset Formula $u(x)=\min_{t}\{u^{t}+\lambda^{t}p^{t}\cdot (x-x^{t})\}\leq u^{s}+\lambda^{s}p^{s}\cdot (x-x^{s})\leq u^{s}=u(x^{s})$
\end_inset

.

\end_layout

\begin_layout Standard
Thus 
\begin_inset Formula $u(x^{s})\geq u(x)$
\end_inset

 when 
\begin_inset Formula $p^{s}\cdot x^{s}\geq p^{s}\cdot x$
\end_inset

.

\end_layout

\begin_layout Standard
\begin_inset Formula $(4)$
\end_inset

 implies 
\begin_inset Formula $(1)$
\end_inset

.
\end_layout

\begin_layout Standard
If 
\begin_inset Formula $u$
\end_inset

 is strictly increasing, then it is locally nonsatiated.
\end_layout

\begin_layout Standard

\end_layout

\begin_layout Standard
\begin_inset ERT
status open

\begin_layout Plain Layout


\backslash
end{proof}
\end_layout

\end_inset


\end_layout

\begin_layout Section
Revealed Preference and the Strong Axiom
\end_layout

\begin_layout Standard
The preceding section used GARP to characterize weak rationalization,
 allowing ties in observed choice.
 This section records the corresponding strict result:
 with single-valued choice and strict concavity,
 SARP replaces GARP and the Afriat inequalities become strict.
 The two results are parallel but answer different rationalizability questions.
\end_layout

\begin_layout Definition
(Strong axiom of revealed preference, SARP.) The dataset satisfies SARP if the transitive closure 
\begin_inset Formula $R$
\end_inset

 has no nontrivial cycle: whenever 
\begin_inset Formula $x^{t}Rx^{s}$
\end_inset

 and 
\begin_inset Formula $x^{t}\neq x^{s}$
\end_inset

, it is not the case that 
\begin_inset Formula $x^{s}Rx^{t}$
\end_inset
.

\end_layout

\begin_layout Standard
SARP is the natural condition when observed choice is single-valued and ties are ruled out.
 The weak Afriat theorem above is the maintained finite-data result in this book; strict rationalization results require additional assumptions, including care with duplicate observed bundles.
\end_layout

\begin_layout Section
Forecasting with Varian's Support Set
\end_layout

\begin_layout Definition
Given a finite price-choice dataset 
\begin_inset Formula $\mathcal O$
\end_inset

 and a new price-wealth pair 
\begin_inset Formula $(p^{K+1},w^{K+1})$
\end_inset

,
 define the augmented dataset associated with a candidate bundle by 
\begin_inset Formula $\mathcal O(x)=\mathcal O\cup\{(p^{K+1},x)\}$
\end_inset
.
 Varian's support set is
\begin_inset Formula
\[
S(p^{K+1},w^{K+1})=\left\{x\in X:\begin{array}{l}\mathcal O(x)\text{ satisfies GARP},\\ p^{K+1}\cdot x=w^{K+1}\end{array}\right\}.
\]

\end_inset


\end_layout

\begin_layout Standard
The definition already gives the exact criterion: a candidate bundle belongs to the support set if it exhausts the new budget and the augmented dataset satisfies GARP.
 The transitive closure must be checked, not only one-step comparisons.
 Whenever an old bundle \begin_inset Formula $x^{t}$\end_inset
 is indirectly revealed preferred to the candidate, GARP requires
 the inequality
\begin_inset Formula
\[
p^{K+1}\cdot x\leq p^{K+1}\cdot x^{t}.
\]

\end_inset
\end_layout

\begin_layout Section
Upper Bounds for Welfare Analysis
\end_layout

\begin_layout Definition
A money metric utility function is defined as 
\begin_inset Formula $m(p,x)=e(p,u(x))$
\end_inset

 where 
\begin_inset Formula $e$
\end_inset

 is the expenditure function associated with 
\begin_inset Formula $u$
\end_inset

,
 
\begin_inset Formula $e(p,\overline{u})=\min_{z\in X}\{p\cdot z:u(z)\geq\overline{u}\}$
\end_inset

.

\end_layout

\begin_layout Standard
For any given 
\begin_inset Formula $p$
\end_inset

,
 
\begin_inset Formula $m(p,x)$
\end_inset

 is a utility function that represents the same preferences as 
\begin_inset Formula $u$
\end_inset

 but is expressed in money units.

\end_layout

\begin_layout Standard
Given a finite dataset 
\begin_inset Formula $\mathcal{O}$
\end_inset

, Varian proposes the following upper bound for money-metric utility:
\end_layout

\begin_layout Standard
\begin_inset Formula
\[
m^{+}(p,x)=\min\{p\cdot x^{t}:x^{t}Rx,\ t=1,\ldots,T\}.
\]

\end_inset


\end_layout

\begin_layout Section
Experiments about Testing Rationality
\end_layout

\begin_layout Standard
(This material is presented in Quah
\begin_inset Foot
status collapsed

\begin_layout Plain Layout
http://www.johnquah.com/uploads/7/5/6/7/75676677/survey-qutweb.pdf
\end_layout

\end_inset

)
\end_layout

\begin_layout Itemize
Data from the portfolio choice experiment in Choi,
 Fisman,
 Gale,
 and Kariv (AER,
 2007).

\end_layout

\begin_layout Itemize
93 undergraduate subjects participated in the experiment at UC Berkeley,
 each completing 50 decision problems under risk.

\end_layout

\begin_layout Itemize
There were two states of the world,
 each occurring with a known probability,
 and two Arrow-Debreu securities,
 one for each state.

\end_layout

\begin_layout Itemize
In each decision problem,
 every subject was given a budget;
 income was normalized to one and state prices were chosen at random.
 47 subjects were subjected to the symmetric treatment,
 where 
\begin_inset Formula $\pi_{1}=\pi_{2}=\frac{1}{2}$
\end_inset

.
 The rest had the asymmetric treatment where 
