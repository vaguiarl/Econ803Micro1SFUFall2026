\begin_layout Section
Afriat's Cost-Efficiency Index

\end_layout

\begin_layout Standard
When a dataset 
\begin_inset Formula $\mathcal{O}$
\end_inset

 fails GARP, the critical cost-efficiency index measures the size of the revealed-preference violation.
 For an efficiency level 
\begin_inset Formula $\alpha\in[0,1]$
\end_inset

, define the efficiency-adjusted direct relations by

\end_layout

\begin_layout Standard
\begin_inset Formula
\[
x^{t}R_{\alpha}^{D}x^{s}\iff \alpha p^{t}\cdot x^{t}\geq p^{t}\cdot x^{s},
\qquad
x^{t}P_{\alpha}^{D}x^{s}\iff \alpha p^{t}\cdot x^{t}>p^{t}\cdot x^{s}.
\]

\end_inset

\end_layout

\begin_layout Standard
Let 
\begin_inset Formula $R_{\alpha}$
\end_inset

 be the transitive closure of 
\begin_inset Formula $R_{\alpha}^{D}$
\end_inset
.
 The dataset satisfies 
\begin_inset Formula $\alpha$
\end_inset
-GARP if, for all observations 
\begin_inset Formula $s,t$
\end_inset
, 
\begin_inset Formula $x^{t}R_{\alpha}x^{s}$
\end_inset

 implies 
\begin_inset Formula $\neg(x^{s}P_{\alpha}^{D}x^{t})$
\end_inset
.
\end_layout

\begin_layout Definition
The Critical Cost Efficiency Index (CCEI) of a dataset 
\begin_inset Formula $\mathcal{O}$
\end_inset

 is 
\begin_inset Formula $\operatorname{CCEI}(\mathcal{O})=\sup\{\alpha\in[0,1]:\mathcal{O}\text{ satisfies }\alpha\text{-GARP}\}$
\end_inset
.
 A value of one means that the original data satisfy GARP; a smaller value is the largest common fraction of observed expenditure that can be retained while eliminating every GARP violation.

\end_layout

