\end_layout

\end_inset


\end_layout

\begin_layout Section
GARP and Afriat's Theorem
\end_layout

\begin_layout Standard
Retain the expenditure-exhausting finite dataset 
\begin_inset Formula $\mathcal{O}=\{(p^{t},x^{t})\}_{t\in\mathbb{T}}$
\end_inset

 and direct revealed preference 
\begin_inset Formula $\succeq^{R,D}$
\end_inset

 from the preceding section.
 Let 
\begin_inset Formula $\notationfirst{revealed-closure}{\succeq^{R}}$
\end_inset

 be its transitive closure on the observed bundles.
 Thus 
\begin_inset Formula $x^{t}\succeq^{R}x^{s}$
\end_inset

 when there is a finite chain of direct weak comparisons from 
\begin_inset Formula $x^{t}$
\end_inset

 to 
\begin_inset Formula $x^{s}$
\end_inset

.
 Define 
\begin_inset Formula $x^{t}\notationfirst{strict-direct-revealed}{\succ^{R,D}}x^{s}$
\end_inset

 when 
\begin_inset Formula $p^{t}\cdot x^{t}>p^{t}\cdot x^{s}$
\end_inset

.
\end_layout

\begin_layout Definition
Utility rationalization of budget data.
 A utility function 
\begin_inset Formula $u:X\to\mathbb{R}$
\end_inset

 rationalizes 
\begin_inset Formula $\mathcal{O}$
\end_inset

 if,
 for every 
\begin_inset Formula $t\in\mathbb{T}$
\end_inset

,
 
\begin_inset Formula $u(x^{t})\geq u(x)$
\end_inset

 whenever 
\begin_inset Formula $p^{t}\cdot x\leq p^{t}\cdot x^{t}$
\end_inset

.
 Ties are allowed,
 so the observed bundle need not be the unique maximizer.
\end_layout

\begin_layout Definition
A finite demand dataset 
\begin_inset Formula $\mathcal{O}=\{(p^{t},x^{t})\}^{T}_{t=1}$
\end_inset

 satisfies the generalized axiom of revealed preference (GARP) if 
\begin_inset Formula 
\[
x^{t}\succeq^{R}x^{s}\quad\Longrightarrow\quad\neg\bigl(x^{s}\succ^{R,D}x^{t}\bigr)
\]

\end_inset

for all observations 
\begin_inset Formula $s,t$
\end_inset

,
 where 
\begin_inset Formula $\succeq^{R}$
\end_inset

 is the transitive closure of direct revealed preference and 
\begin_inset Formula 
\[
x^{s}\succ^{R,D}x^{t}\iff p^{s}\cdot x^{s}>p^{s}\cdot x^{t}.
\]

\end_inset

Equivalently,
 a chain of weak revealed-preference comparisons may not be closed by a strict direct comparison in the opposite direction.
\end_layout

\begin_layout Proposition
(Afriat's theorem.) Let 
\begin_inset Formula $\mathcal{O}=\{(p^{t},x^{t})\}^{T}_{t=1}$
\end_inset

 be a finite dataset with 
\begin_inset Formula $p^{t}\gg0$
\end_inset

 and 
\begin_inset Formula $x^{t}\in\mathbb{R}^{L}_{+}$
\end_inset

 for every observation 
\begin_inset Formula $t$
\end_inset

.
 The following are equivalent:
\end_layout

\begin_layout Proposition
1.
 There exists a locally nonsatiated utility function 
\begin_inset Formula $u$
\end_inset

 that rationalizes the data in the sense that for all 
\begin_inset Formula $t$
\end_inset

,
 
\begin_inset Formula $u(x^{t})\geq u(x)$
\end_inset

 for all 
\begin_inset Formula $x$
\end_inset

 such that 
\begin_inset Formula $p^{t}\cdot x^{t}\geq p^{t}\cdot x$
\end_inset

.
\end_layout

\begin_layout Proposition
2.
 The dataset 
\begin_inset Formula $\mathcal{O}=\{(p^{t},x^{t})\}^{T}_{t=1}$
\end_inset

 satisfies GARP.
\end_layout

\begin_layout Proposition
3.
 There exist numbers 
\begin_inset Formula $\notationfirst{afriat-certificates}{(U^{t},\lambda^{t})}\in\mathbb{R}\times\mathbb{R}_{++}$
\end_inset

 satisfying the Afriat inequalities
\end_layout

\begin_layout Proposition
\begin_inset Formula 
\[
U^{t}\leq U^{s}+\lambda^{s}p^{s}\cdot(x^{t}-x^{s})\quad\forall s,t\in\{1,\ldots,T\}
\]

\end_inset


\end_layout

\begin_layout Proposition
4.
 There exists a continuous,
 concave,
 and strictly increasing utility function 
\begin_inset Formula $u$
\end_inset

 that rationalizes the data in the sense that for all 
\begin_inset Formula $t$
\end_inset

,
 
\begin_inset Formula $u(x^{t})\geq u(x)$
\end_inset

 for all 
\begin_inset Formula $x$
\end_inset

 such that 
\begin_inset Formula $p^{t}\cdot x^{t}\geq p^{t}\cdot x$
\end_inset

.
\end_layout

\begin_layout Standard
\begin_inset ERT
status open

\begin_layout Plain Layout

\backslash
begin{proof}
\end_layout

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $(1)\implies(2),(2)\implies(3),(3)\implies(4),(4)\implies(1)$
\end_inset

.
\end_layout

\begin_layout Standard
(
\begin_inset Formula $1$
\end_inset

) implies (2),
\end_layout

\begin_layout Standard
Assume that 
\begin_inset Formula $\mathcal{O}$
\end_inset

 is rationalized by a locally nonsatiated utility function and suppose,
 toward a contradiction,
 that GARP fails.
 Then there are observation indices 
\begin_inset Formula $t_{0},\ldots,t_{m}$
\end_inset

 such that 
\begin_inset Formula $x^{t_{k-1}}\succeq^{R,D}x^{t_{k}}$
\end_inset

 for 
\begin_inset Formula $k=1,\ldots,m$
\end_inset

 and 
\begin_inset Formula $x^{t_{m}}\succ^{R,D}x^{t_{0}}$
\end_inset

.
 Rationalization gives 
\begin_inset Formula $u(x^{t_{0}})\geq\cdots\geq u(x^{t_{m}})$
\end_inset

.
 The strict comparison implies 
\begin_inset Formula $p^{t_{m}}\cdot x^{t_{0}}<p^{t_{m}}\cdot x^{t_{m}}$
\end_inset

.
 By local nonsatiation,
 there is a bundle 
\begin_inset Formula $y$
\end_inset

 with 
\begin_inset Formula $\lVert y-x^{t_{0}}\rVert_{2}<\varepsilon$
\end_inset

 and 
\begin_inset Formula $u(y)>u(x^{t_{0}})$
\end_inset

;
 choosing 
\begin_inset Formula $\varepsilon>0$
\end_inset

 sufficiently small preserves strict affordability at prices 
\begin_inset Formula $p^{t_{m}}$
\end_inset

.
 Thus 
\begin_inset Formula $y$
\end_inset

 is affordable at observation 
\begin_inset Formula $t_{m}$
\end_inset

 and satisfies 
\begin_inset Formula $u(y)>u(x^{t_{m}})$
\end_inset

,
 contradicting rationalization.
\end_layout

\begin_layout Standard
\begin_inset Formula $(2)$
\end_inset

 implies 
\begin_inset Formula $(3)$
\end_inset


\end_layout

\begin_layout Standard
The implication from GARP to the Afriat inequalities is the finite Afriat feasibility lemma.
 It is a theorem of alternatives for the displayed linear system,
 not an immediate consequence of naming Farkas' lemma.
 We cite the lemma here:
 for a finite,
 expenditure-exhausting dataset with strictly positive prices,
 GARP holds if and only if there exist 
\begin_inset Formula $(U^{1},\ldots,U^{T})$
\end_inset

 and positive 
\begin_inset Formula $(\lambda^{1},\ldots,\lambda^{T})$
\end_inset

 satisfying every Afriat inequality.
 The converse can be seen directly by summing the inequalities around a revealed-preference cycle;
 the forward direction uses the full finite feasibility lemma.
\end_layout

\begin_layout Standard
\begin_inset Formula $(3)$
\end_inset

 implies 
\begin_inset Formula $(4)$
\end_inset


\end_layout

\begin_layout Standard
Let 
\begin_inset Formula $u(x)=\min_{t\in\{1,\ldots,T\}}\{U^{t}+\lambda^{t}p^{t}\cdot(x-x^{t})\}$
\end_inset

.
 As the pointwise minimum of finitely many affine functions,
 
\begin_inset Formula $u$
\end_inset

 is continuous and concave.
 It is strictly increasing in the product order because 
\begin_inset Formula $\lambda^{t}>0$
\end_inset

 and 
\begin_inset Formula $p^{t}\gg0$
\end_inset

 for every observation 
\begin_inset Formula $t$
\end_inset

.
\end_layout

\begin_layout Standard
To verify rationalization,
 first observe that 
\begin_inset Formula $u(x^{t})=U^{t}$
\end_inset

 for every observation 
\begin_inset Formula $t$
\end_inset

.
 Indeed,
 the Afriat inequality gives 
\begin_inset Formula 
\[
U^{t}\leq U^{m}+\lambda^{m}p^{m}\cdot(x^{t}-x^{m})
\]

\end_inset

for every 
\begin_inset Formula $m$
\end_inset

,
 while the term with 
\begin_inset Formula $m=t$
\end_inset

 equals 
\begin_inset Formula $U^{t}$
\end_inset

.
 Therefore the minimum of these affine terms is exactly 
\begin_inset Formula $U^{t}$
\end_inset

.
\end_layout

\begin_layout Standard
It remains to show that 
\begin_inset Formula $u(x)\leq u(x^{s})$
\end_inset

,
 if 
\begin_inset Formula $p^{s}\cdot x^{s}\geq p^{s}\cdot x$
\end_inset


\end_layout

\begin_layout Standard
If 
\begin_inset Formula $p^{s}\cdot x^{s}\geq p^{s}\cdot x$
\end_inset

,
 or 
\begin_inset Formula $p^{s}\cdot(x^{s}-x)\geq0$
\end_inset

,
 then 
\begin_inset Formula $u(x)=\min_{t}\{U^{t}+\lambda^{t}p^{t}\cdot(x-x^{t})\}\leq U^{s}+\lambda^{s}p^{s}\cdot(x-x^{s})\leq U^{s}=u(x^{s})$
\end_inset

.
\end_layout

\begin_layout Standard
Thus 
\begin_inset Formula $u(x^{s})\geq u(x)$
\end_inset

 when 
\begin_inset Formula $p^{s}\cdot x^{s}\geq p^{s}\cdot x$
\end_inset

.
\end_layout

\begin_layout Standard
\begin_inset Formula $(4)$
\end_inset

 implies 
\begin_inset Formula $(1)$
\end_inset

.
\end_layout

\begin_layout Standard
If 
\begin_inset Formula $u$
\end_inset

 is strictly increasing,
 then it is locally nonsatiated.
\end_layout

\begin_layout Standard

\end_layout

\begin_layout Standard
\begin_inset ERT
status open

\begin_layout Plain Layout

\backslash
end{proof}
\end_layout

\end_inset


\end_layout


\begin_layout Standard
\begin_inset Note Note
status collapsed

