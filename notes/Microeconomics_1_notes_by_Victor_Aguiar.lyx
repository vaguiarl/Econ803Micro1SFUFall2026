\begin_layout Section
Attitudes towards Risk
\end_layout

\begin_layout Standard
Assume that Bernoulli utility is defined on the convex hull 
\begin_inset Formula $\operatorname{co}(Z)$
\end_inset

 of the finite monetary-prize set.
  For a lottery 
\begin_inset Formula $\mu\in\Delta(Z)$
\end_inset

,
 its expected monetary value is 
\begin_inset Formula $\overline{z}(\mu)=\sum_{z\in Z}z\mu(z)\in\operatorname{co}(Z)$
\end_inset

.
\end_layout

\begin_layout Definition
Risk aversion under expected utility.
 A decision maker is risk averse on this finite lottery domain if 
\begin_inset Formula $u(\overline{z}(\mu))\geq U(\mu)$
\end_inset

 for every lottery 
\begin_inset Formula $\mu\in\Delta(Z)$
\end_inset

.
 By Jensen's inequality,
 concavity of the Bernoulli utility implies this condition:
 
\begin_inset Formula 
\[
\sum_{z\in Z}\mu(z)u(z)\leq u\!\left(\sum_{z\in Z}\mu(z)z\right).
\]

\end_inset

 If the same comparison is required for every finitely supported lottery with prizes in 
\begin_inset Formula $\operatorname{co}(Z)$
\end_inset

,
 applying it to arbitrary two-point lotteries also makes concavity necessary.
\end_layout

\begin_layout Definition
Certainty equivalent and risk premium.
 If 
\begin_inset Formula $u$
\end_inset

 is strictly increasing and its range contains 
\begin_inset Formula $U(\mu)$
\end_inset

,
 the certainty equivalent is the prize 
\begin_inset Formula $\notationfirst{certainty-equivalent}{\operatorname{CE}(\mu;u)}=u^{-1}(U(\mu))$
\end_inset

 and the (monetary) risk premium is 
\begin_inset Formula $\notationfirst{risk-premium}{\operatorname{RP}(\mu;u)}=\overline{z}(\mu)-\operatorname{CE}(\mu;u)$
\end_inset

.
 A risk-averse expected-utility decision maker has 
\begin_inset Formula $\operatorname{RP}(\mu;u)\geq0$
\end_inset

.
\end_layout

\begin_layout Definition
Probability premium.
 For prizes 
\begin_inset Formula $x-\varepsilon,x,x+\varepsilon$
\end_inset

 in the domain of 
\begin_inset Formula $u$
\end_inset

,
 
\begin_inset Formula $\notationfirst{probability-premium}{\operatorname{PP}(x,\varepsilon;u)}$
\end_inset

 is defined by 
\begin_inset Formula 
\[
u(x)=\left(\frac{1}{2}+\operatorname{PP}(x,\varepsilon;u)\right)u(x+\varepsilon)+\left(\frac{1}{2}-\operatorname{PP}(x,\varepsilon;u)\right)u(x-\varepsilon).
\]

\end_inset

 It is the change in probability needed to make the symmetric two-point lottery equivalent to the sure prize.
\end_layout

\begin_layout Proposition
For a twice differentiable,
 strictly increasing Bernoulli utility,
 the local risk premium for a symmetric small spread satisfies 
\begin_inset Formula 
\[
\operatorname{RP}\bigl(\tfrac{1}{2}\delta_{x-\varepsilon}+\tfrac{1}{2}\delta_{x+\varepsilon};u\bigr)=-\frac{u''(x)}{2u'(x)}\varepsilon^{2}+o(\varepsilon^{2}).
\]

\end_inset

 Thus local concavity corresponds to a nonnegative local risk premium.
\end_layout

\begin_layout Section
First-Order Stochastic Dominance:
 Finite Support
\end_layout

\begin_layout Definition
First-order stochastic dominance.
 For lotteries 
\begin_inset Formula $\mu,\nu\in\Delta(Z)$
\end_inset

 with cumulative distribution functions 
\begin_inset Formula $\notationfirst{lottery-cdf}{F_{\mu}}(t)=\sum_{z\leq t}\mu(z)$
\end_inset

 and 
\begin_inset Formula $F_{\nu}(t)=\sum_{z\leq t}\nu(z)$
\end_inset

,
 write 
\begin_inset Formula $\mu\notationfirst{fosd}{\succeq^{\mathrm{FOSD}}}\nu$
\end_inset

 if 
\begin_inset Formula $F_{\mu}(t)\leq F_{\nu}(t)$
\end_inset

 for every 
\begin_inset Formula $t\in\mathbb{R}$
\end_inset

.
 The relation is generally incomplete.
\end_layout

\begin_layout Theorem
If 
\begin_inset Formula $\mu\succeq^{\mathrm{FOSD}}\nu$
\end_inset

 and 
\begin_inset Formula $u$
\end_inset

 is increasing,
 then 
\begin_inset Formula $U(\mu)\geq U(\nu)$
\end_inset

 for expected utility 
\begin_inset Formula $U$
\end_inset

.
 If the prizes are ordered as 
\begin_inset Formula $Z=\{z_{1}<\cdots<z_{N}\}$
\end_inset

,
 strict inequality follows whenever 
\begin_inset Formula $F_{\mu}(z_{k})<F_{\nu}(z_{k})$
\end_inset

 and 
\begin_inset Formula $u(z_{k+1})>u(z_{k})$
\end_inset

 for at least one cutoff 
\begin_inset Formula $k<N$
\end_inset

.
\end_layout

\begin_layout Section
Portfolio Choice:
 Demand for a Risky Asset
\end_layout

\begin_layout Standard
An asset is a divisible claim to a financial return in the future.
 Assume that 
\begin_inset Formula $u$
\end_inset

 is continuously differentiable,
 strictly increasing,
 and concave on an interval containing every feasible terminal-wealth realization.
 Assume also that the return and marginal-utility expressions below are integrable.
\end_layout

\begin_layout Standard
Let 
\begin_inset Formula $\alpha,\beta$
\end_inset

 denote the amounts of money invested in a risky and safe asset respectively.
 The risky asset pays a random gross return 
\begin_inset Formula $\widetilde{R}$
\end_inset

 dollars per dollar invested and the safe asset pays 
\begin_inset Formula $1$
\end_inset

 dollar with certainty per dollar invested.
 The random return has cumulative distribution function 
\begin_inset Formula $F_{R}(r)$
\end_inset

 We assume that 
\begin_inset Formula $\mathbb{E}[\widetilde{R}]=\int r\,dF_{R}(r)>1$
\end_inset

,
 or that the risky asset expected return exceeds the return of the safe asset.
 Then the total return is 
\begin_inset Formula $\alpha\widetilde{R}+\beta$
\end_inset

.
 Feasibility requires 
\begin_inset Formula $\alpha+\beta=w$
\end_inset

.
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\max_{\alpha,\beta\geq0}\int u(\alpha r+\beta)\,dF_{R}(r)
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\text{subject to}\quad\alpha+\beta=w.
\]

\end_inset


\end_layout

\begin_layout Standard
Substituting 
\begin_inset Formula $\beta=w-\alpha$
\end_inset

 reduces the problem to
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\max_{0\leq\alpha\leq w}\int u(w+\alpha(r-1))\,dF_{R}(r).
\]

\end_inset


\end_layout

\begin_layout Standard
Define the derivative of the objective on 
\begin_inset Formula $[0,w]$
\end_inset

 by 
\begin_inset Formula 
\[
\phi(\alpha)=\int u'(w+\alpha[r-1])[r-1]\,dF_{R}(r).
\]

\end_inset

 The necessary and sufficient first-order conditions for an optimum 
\begin_inset Formula $\alpha^{*}$
\end_inset

 are 
\begin_inset Formula 
\[
\begin{cases}
\phi(\alpha^{*})\leq0 & \text{if }\alpha^{*}<w,\\
\phi(\alpha^{*})\geq0 & \text{if }\alpha^{*}>0.
\end{cases}
\]

\end_inset

 Because 
\begin_inset Formula $u'(w)>0$
\end_inset

 and 
\begin_inset Formula $\int r\,dF_{R}(r)>1$
\end_inset

,
 we have 
\begin_inset Formula $\phi(0)=u'(w)\int(r-1)\,dF_{R}(r)>0$
\end_inset

.
  Hence 
\begin_inset Formula $\alpha^{*}=0$
\end_inset

 cannot satisfy the first-order conditions.
\end_layout

\begin_layout Standard
If a risk is actuarially favorable,
 then a risk-averse expected-utility maximizer will accept at least a sufficiently small amount under the stated differentiability and interior-wealth assumptions.
\end_layout

\begin_layout Section
Revealed Expected Utility under Risk Aversion
\end_layout

\begin_layout Standard
Let 
\begin_inset Formula $\notationfirst{state-space}{\mathcal{S}}$
\end_inset

 be a finite set of states with fixed probabilities 
\begin_inset Formula $\notationfirst{state-probabilities}{\varpi_{s}}>0$
\end_inset

,
 satisfying 
\begin_inset Formula $\sum_{s\in\mathcal{S}}\varpi_{s}=1$
\end_inset

,
 and let a contingent consumption plan be 
\begin_inset Formula $x=(x_{s})_{s\in\mathcal{S}}\in\mathbb{R}^{\mathcal{S}}_{++}$
\end_inset

.
 At prices 
\begin_inset Formula $p\in\mathbb{R}^{\mathcal{S}}_{++}$
\end_inset

 and wealth 
\begin_inset Formula $w>0$
\end_inset

,
 the consumer solves 
\begin_inset Formula $\max_{x}\sum_{s\in\mathcal{S}}\varpi_{s}u(x_{s})\text{ subject to }\sum_{s\in\mathcal{S}}p_{s}x_{s}\leq w$
\end_inset

,
 where 
\begin_inset Formula $u$
\end_inset

 is continuous,
 strictly increasing and concave,
 with positive marginal utility on the observed consumption range whenever derivatives are invoked.
\end_layout

\begin_layout Proposition
Interior first-order conditions.
 If 
\begin_inset Formula $u$
\end_inset

 is differentiable and an optimum is interior,
 then there is 
\begin_inset Formula $\lambda>0$
\end_inset

 such that 
\begin_inset Formula $\varpi_{s}u'(x_{s})=\lambda p_{s}$
\end_inset

 for every 
\begin_inset Formula $s\in\mathcal{S}$
\end_inset

.
 Concavity makes these conditions sufficient for a global optimum;
 boundary observations require the corresponding KKT inequalities.
\end_layout

\begin_layout Definition
Risk-averse expected-utility rationalization.
 A finite dataset 
\begin_inset Formula $\mathcal{O}=\{(p^{t},x^{t})\}_{t\in\mathbb{T}}$
\end_inset

 is rationalized if there is one continuous,
 strictly increasing and concave Bernoulli utility with positive marginal utility on the observed range 
\begin_inset Formula $u$
\end_inset

 such that each 
\begin_inset Formula $x^{t}$
\end_inset

 maximizes 
\begin_inset Formula $\sum_{s}\varpi_{s}u(x_{s})$
\end_inset

 on the budget set 
\begin_inset Formula $\{x:p^{t}\cdot x\leq p^{t}\cdot x^{t}\}$
\end_inset

.
\end_layout

\begin_layout Theorem
Finite-data test.
 See
\begin_inset CommandInset citation
LatexCommand citep
key "polissonquahrenou2020"
literal "false"

\end_inset

.
 Assume all observations are interior and 
\begin_inset Formula $\varpi_{s}>0$
\end_inset

.
 The dataset has a risk-averse expected-utility rationalization if and only if there are numbers 
\begin_inset Formula $\beta^{t}_{s}>0$
\end_inset

 and 
\begin_inset Formula $\lambda^{t}>0$
\end_inset

 that satisfy the price equations 
\begin_inset Formula 
\[
\varpi_{s}\beta^{t}_{s}=\lambda^{t}p^{t}_{s}\qquad\text{for every }s,t,
\]

\end_inset

 and the monotonicity inequalities 
\begin_inset Formula 
\[
x^{t}_{s}>x^{t'}_{s'}\quad\Longrightarrow\quad\beta^{t}_{s}\leq\beta^{t'}_{s'}
\]

\end_inset

 for every pair of observed state-contingent quantities.
 The monotonicity condition is the finite signature of a single decreasing marginal-utility function;
 the price equations are the common first-order conditions.
\end_layout

\begin_layout Standard
The theorem is an Afriat-style interpolation result for one Bernoulli utility across states and observations.
 It is stated for interior data to keep the notation transparent;
 zero quantities are handled by replacing equalities with KKT inequalities.
\end_layout

