\begin_layout Chapter
General Equilibrium Theory
\end_layout

\begin_layout Standard
\begin_inset CommandInset label
LatexCommand label
name "chap:general-equilibrium"

\end_inset


\end_layout

\begin_layout Standard
General equilibrium studies all markets simultaneously.
  Prices determine individual budget sets,
 firms' feasible transformations,
 and the wealth generated by ownership claims;
 an equilibrium is a fixed point at which every agent optimizes and all markets clear.
\end_layout

\begin_layout Section
Pure exchange economies:
 the Edgeworth box
\end_layout

\begin_layout Standard
Consider two consumers 
\begin_inset Formula $i=1,2$
\end_inset

 and two goods 
\begin_inset Formula $\ell=1,2$
\end_inset

.
 Consumer 
\begin_inset Formula $i$
\end_inset

 has consumption set 
\begin_inset Formula $X_{i}=\mathbb{R}^{2}_{+}$
\end_inset

,
 preference relation 
\begin_inset Formula $\succeq_{i}$
\end_inset

,
 and endowment 
\begin_inset Formula $\omega_{i}=(\omega_{i1},\omega_{i2})\in\mathbb{R}^{2}_{+}$
\end_inset

.
 Aggregate endowment is 
\begin_inset Formula $\omega=\omega_{1}+\omega_{2}\gg0$
\end_inset

.
 An allocation 
\begin_inset Formula $x=(x_{1},x_{2})$
\end_inset

 is feasible when 
\begin_inset Formula $x_{1}+x_{2}\leq\omega$
\end_inset

 componentwise.
\end_layout

\begin_layout Standard
At prices 
\begin_inset Formula $p\gg0$
\end_inset

,
 consumer 
\begin_inset Formula $i$
\end_inset

 has wealth 
\begin_inset Formula $p\cdot\omega_{i}$
\end_inset

 and budget set 
\begin_inset Formula 
\[
B_{i}(p)=\{x_{i}\in X_{i}:p\cdot x_{i}\leq p\cdot\omega_{i}\}.
\]

\end_inset


\end_layout

\begin_layout Definition
Walrasian equilibrium in the exchange economy.
 A pair 
\begin_inset Formula $(p^{*},x^{*})$
\end_inset

 with 
\begin_inset Formula $p^{*}\gg0$
\end_inset

 is an equilibrium if markets clear,
 
\begin_inset Formula $x^{*}_{1}+x^{*}_{2}=\omega$
\end_inset

,
 and 
\begin_inset Formula 
\[
x^{*}_{i}\succeq_{i}x_{i}\quad\text{for every }x_{i}\in B_{i}(p^{*}),\quad i=1,2.
\]

\end_inset

 Prices are defined only up to multiplication by a positive scalar.
\end_layout

\begin_layout Example
Cobb--Douglas exchange.
 Suppose 
\begin_inset Formula $u_{i}(x_{i1},x_{i2})=x^{\alpha}_{i1}x^{1-\alpha}_{i2}$
\end_inset

 with 
\begin_inset Formula $0<\alpha<1$
\end_inset

,
 and endowments 
\begin_inset Formula $\omega_{1}=(1,2)$
\end_inset

 and 
\begin_inset Formula $\omega_{2}=(2,1)$
\end_inset

.
 The demands are
\end_layout

\begin_layout Example
\begin_inset Formula 
\[
x_{1}(p)=\left(\frac{\alpha(p_{1}+2p_{2})}{p_{1}},\frac{(1-\alpha)(p_{1}+2p_{2})}{p_{2}}\right),\quad x_{2}(p)=\left(\frac{\alpha(2p_{1}+p_{2})}{p_{1}},\frac{(1-\alpha)(2p_{1}+p_{2})}{p_{2}}\right).
\]

\end_inset


\end_layout

\begin_layout Standard
Clearing good 1 gives 
\begin_inset Formula $p_{1}/p_{2}=\alpha/(1-\alpha)$
\end_inset

;
 one may normalize 
\begin_inset Formula $p_{2}=1$
\end_inset

 and recover the allocation from the two demands.
\end_layout

\begin_layout Definition
Pareto efficiency.
 A feasible allocation 
\begin_inset Formula $x$
\end_inset

 is Pareto efficient if there is no feasible 
\begin_inset Formula $x'$
\end_inset

 with 
\begin_inset Formula $x_{i}'\succeq_{i}x_{i}$
\end_inset

 for every 
\begin_inset Formula $i\in\{1,2\}$
\end_inset

 and 
\begin_inset Formula $x_{i}'\succ_{i}x_{i}$
\end_inset

 for at least one 
\begin_inset Formula $i\in\{1,2\}$
\end_inset

.
 The Pareto set is the set of all such allocations for the fixed aggregate endowment.
\end_layout

\begin_layout Proposition
First welfare theorem for the exchange box.
 See
\begin_inset CommandInset citation
LatexCommand citep
key "mwg1995"
literal "false"

\end_inset

.
 If preferences are locally nonsatiated and 
\begin_inset Formula $(p^{*},x^{*})$
\end_inset

 is a Walrasian equilibrium,
 then 
\begin_inset Formula $x^{*}$
\end_inset

 is Pareto efficient.
\end_layout

\begin_layout Proposition
Second welfare theorem for the exchange box.
 See
\begin_inset CommandInset citation
LatexCommand citep
key "mwg1995"
literal "false"

\end_inset

.
 If preferences are continuous,
 convex,
 and strongly monotone,
 every Pareto-efficient allocation can be supported by a positive price vector after suitable lump-sum transfers 
\begin_inset Formula $T_{1}+T_{2}=0$
\end_inset

.
 The transfers change wealth,
 not relative prices.
\end_layout

\begin_layout Section
One consumer and one producer
\end_layout

\begin_layout Standard
There is one consumer with labor-time endowment 
\begin_inset Formula $\overline{N}$
\end_inset

 of time and no initial endowment of the consumption good.
  The consumption set is 
\begin_inset Formula $X=[0,\overline{N}]\times\mathbb{R}_{+}$
\end_inset

,
 and 
\begin_inset Formula $u:X\to\mathbb{R}$
\end_inset

 is the consumer's utility function.
  Let 
\begin_inset Formula $x_{1}$
\end_inset

 be leisure,
 
\begin_inset Formula $x_{2}$
\end_inset

 consumption,
 and 
\begin_inset Formula $f(z)$
\end_inset

 output from labor 
\begin_inset Formula $z\geq0$
\end_inset

.
 At output price 
\begin_inset Formula $p>0$
\end_inset

 and wage 
\begin_inset Formula $w>0$
\end_inset

,
 the firm solves
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\pi_{f}(p,w):=\max_{z\geq0}\{pf(z)-wz\}.
\]

\end_inset


\end_layout

\begin_layout Standard
The consumer owns the firm,
 receives profit 
\begin_inset Formula $\pi_{f}(p,w)$
\end_inset

,
 and solves
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\max_{(x_{1},x_{2})\in X}u(x_{1},x_{2})\quad\text{subject to}\quad px_{2}\leq w(\overline{N}-x_{1})+\pi_{f}(p,w).
\]

\end_inset


\end_layout

\begin_layout Definition
A competitive equilibrium is a price pair 
\begin_inset Formula $(p^{*},w^{*})$
\end_inset

 and choices 
\begin_inset Formula $(x^{*},z^{*})$
\end_inset

 satisfying both optimization problems and the clearing conditions 
\begin_inset Formula 
\[
x^{*}_{2}=f(z^{*}),\qquad z^{*}=\overline{N}-x^{*}_{1}.
\]

\end_inset


\end_layout

\begin_layout Proposition
Under continuity,
 convexity,
 local nonsatiation,
 and the usual concavity and attainment assumptions,
 a competitive allocation solves the central-planner problem 
\begin_inset Formula 
\[
\max_{x_{1},x_{2}}u(x_{1},x_{2})\quad\text{subject to}\quad x_{2}\leq f(\overline{N}-x_{1}),\quad0\leq x_{1}\leq\overline{N}.
\]

\end_inset

 Conversely,
 an interior planner solution can be supported by prices equal to the relevant marginal rates.
\end_layout

\begin_layout Section
Production,
 ownership,
 and feasibility
\end_layout

\begin_layout Standard
Consider 
\begin_inset Formula $I$
\end_inset

 consumers,
 
\begin_inset Formula $J$
\end_inset

 firms,
 and 
\begin_inset Formula $L$
\end_inset

 commodities.
  Consumer 
\begin_inset Formula $i$
\end_inset

 has consumption set 
\begin_inset Formula $X_{i}$
\end_inset

,
 preference 
\begin_inset Formula $\succeq_{i}$
\end_inset

 represented by 
\begin_inset Formula $u_{i}:X_{i}\to\mathbb{R}$
\end_inset

,
 and endowment 
\begin_inset Formula $\omega_{i}\in\mathbb{R}^{L}$
\end_inset

;
 firm 
\begin_inset Formula $j$
\end_inset

 has production set 
\begin_inset Formula $Y_{j}\subseteq\mathbb{R}^{L}$
\end_inset

.
 Let 
\begin_inset Formula $\omega=\sum_{i}\omega_{i}$
\end_inset

.
 An allocation 
\begin_inset Formula $(x,y)$
\end_inset

 is feasible when 
\begin_inset Formula 
\[
\sum^{I}_{i=1}x_{i}\leq\omega+\sum^{J}_{j=1}y_{j}.
\]

\end_inset


\end_layout

\begin_layout Standard
In a private-ownership economy,
 consumer 
\begin_inset Formula $i$
\end_inset

 owns share 
\begin_inset Formula $\theta_{ij}\in[0,1]$
\end_inset

 of firm 
\begin_inset Formula $j$
\end_inset

,
 with 
\begin_inset Formula $\sum_{i}\theta_{ij}=1$
\end_inset

 for each 
\begin_inset Formula $j$
\end_inset

.
\end_layout

\begin_layout Definition
Walrasian equilibrium.
 A price vector 
\begin_inset Formula $p\gg0$
\end_inset

 and allocation 
\begin_inset Formula $(x^{*},y^{*})$
\end_inset

 form an equilibrium when,
 for every firm,
 
\begin_inset Formula 
\[
y^{*}_{j}\in\arg\max_{y_{j}\in Y_{j}}p\cdot y_{j},
\]

\end_inset


\end_layout

\begin_layout Standard
and,
 for every consumer,
 
\begin_inset Formula 
\[
x^{*}_{i}\in\arg\max_{x_{i}\in X_{i}}\{u_{i}(x_{i}):p\cdot x_{i}\leq p\cdot\omega_{i}+\sum_{j}\theta_{ij}p\cdot y^{*}_{j}\},
\]

\end_inset


\end_layout

\begin_layout Standard
with market clearing 
\begin_inset Formula $\sum_{i}x^{*}_{i}=\omega+\sum_{j}y^{*}_{j}$
\end_inset

.
\end_layout

\begin_layout Definition
Price equilibrium with transfers.
 Replace each consumer's ownership wealth by an assigned 
\begin_inset Formula $w_{i}$
\end_inset

 satisfying 
\begin_inset Formula $\sum_{i}w_{i}=p\cdot\omega+\sum_{j}p\cdot y^{*}_{j}$
\end_inset

,
 and require 
\begin_inset Formula $x^{*}_{i}\in\arg\max\{u_{i}(x_{i}):p\cdot x_{i}\leq w_{i}\}$
\end_inset

 while firms maximize profit and markets clear.
\end_layout

\begin_layout Section
Welfare theorems
\end_layout

\begin_layout Proposition
First Fundamental Welfare Theorem.
 See
\begin_inset CommandInset citation
LatexCommand citep
key "debreu1959,mwg1995"
literal "false"

\end_inset

.
 If preferences are locally nonsatiated and 
\begin_inset Formula $(p,x^{*},y^{*})$
\end_inset

 is a price equilibrium with transfers,
 then 
\begin_inset Formula $(x^{*},y^{*})$
\end_inset

 is Pareto efficient.
  A Walrasian equilibrium is the special case in which wealth is generated by endowments and ownership shares.
\end_layout

\begin_layout Standard
The proof is the supporting-price argument.
 Consumer optimality and local nonsatiation imply that every bundle weakly preferred to 
\begin_inset Formula $x^{*}_{i}$
\end_inset

 costs at least 
\begin_inset Formula $w_{i}$
\end_inset

;
 a strictly preferred bundle costs strictly more.
 A Pareto improvement therefore has weakly greater expenditure for every consumer and strictly greater expenditure for at least one consumer.
 Summing and combining this strict inequality with firm profit maximization contradicts feasibility and market clearing.
\end_layout

\begin_layout Definition
Price quasi-equilibrium with transfers.
 A nonzero price vector,
 allocation,
 and assigned wealths form a price quasi-equilibrium with transfers when firms maximize profit,
 markets clear,
 
\begin_inset Formula $p\cdot x^{*}_{i}=w_{i}$
\end_inset

 for every consumer,
 the assigned wealths add to aggregate endowment and profit value,
 and every bundle strictly preferred to 
\begin_inset Formula $x^{*}_{i}$
\end_inset

 has cost at least 
\begin_inset Formula $w_{i}$
\end_inset

.
\end_layout

\begin_layout Proposition
Second Fundamental Welfare Theorem.
 See
\begin_inset CommandInset citation
LatexCommand citep
key "debreu1959,mwg1995"
literal "false"

\end_inset

.
 Suppose every production set is closed and convex,
 every preference is convex,
 continuous,
 and locally nonsatiated,
 and the aggregate attainable set is closed.
  Every Pareto-efficient allocation can be supported by a nonzero price vector as a price quasi-equilibrium with transfers.
  If,
 for every consumer,
 there is a bundle 
\begin_inset Formula $\widehat{x}_{i}\in X_{i}$
\end_inset

 with 
\begin_inset Formula $p\cdot\widehat{x}_{i}<w_{i}$
\end_inset

,
 continuity and convexity upgrade the quasi-equilibrium to a price equilibrium with transfers.
\end_layout

\begin_layout Standard
 The result follows by separating the convex aggregate set of bundles that make every consumer strictly better off from the convex aggregate production-plus-endowment set.
  The existence of a strictly cheaper feasible bundle for each consumer supplies the final upgrade from weak support to full budget maximization.
\end_layout

\begin_layout Section
General equilibrium with inattention
\end_layout

\begin_layout Standard
An inattention model must distinguish true prices from the prices or signals used by a consumer's decision rule.
  Fix 
\begin_inset Formula $\underline{m}_{i}\in(0,1]$
\end_inset

 and let the admissible attention class be 
\begin_inset Formula $\mathcal{M}_{i}=\{\operatorname{diag}(m_{i1},\ldots,m_{iL}):m_{i\ell}\in[\underline{m}_{i},1]\}$
\end_inset

.
 Thus 
\begin_inset Formula $M_{i}p\gg0$
\end_inset

 whenever 
\begin_inset Formula $M_{i}\in\mathcal{M}_{i}$
\end_inset

 and 
\begin_inset Formula $p\gg0$
\end_inset

.
 Write 
\begin_inset Formula $D^{\mathrm{B}}_{i}(p,M_{i})$
\end_inset

 for the demand correspondence generated by the fully specified behavioral model,
 while the unadorned 
\begin_inset Formula $D_{i}(p,w_{i})$
\end_inset

 remains ordinary Walrasian demand at true prices and wealth.
 The model must state whether 
\begin_inset Formula $M_{i}$
\end_inset

 changes perceived prices,
 the budget,
 utility,
 or information.
\end_layout

\begin_layout Standard
For a price-perception benchmark,
 
\begin_inset Formula $\widetilde{p}_{i}=M_{i}p$
\end_inset

 and a possible behavioral budget are written explicitly,
 for example 
\begin_inset Formula 
\[
D^{\mathrm{B}}_{i}(p,M_{i})=\arg\max_{x\in X_{i}}\{u_{i}(x):\widetilde{p}_{i}\cdot x\leq\widetilde{p}_{i}\cdot\omega_{i}\}.
\]

\end_inset

 This is not a Walrasian budget unless 
\begin_inset Formula $M_{i}=I_{L}$
\end_inset

 or the model separately establishes equivalence with the true budget.
\end_layout

\begin_layout Definition
Inattention equilibrium.
 A pair 
\begin_inset Formula $(p,x)$
\end_inset

 is an inattention equilibrium when each 
\begin_inset Formula $x_{i}\in D^{\mathrm{B}}_{i}(p,M_{i})$
\end_inset

 satisfies the model's actual feasibility restrictions and 
\begin_inset Formula 
\[
\sum^{I}_{i=1}x_{i}=\sum^{I}_{i=1}\omega_{i}.
\]

\end_inset


\end_layout

\begin_layout Proposition
Compatibility with Pareto efficiency.
 Suppose preferences are differentiable,
 strictly increasing,
 and concave and 
\begin_inset Formula $x^{*}$
\end_inset

 is an interior Pareto-efficient allocation.
  Then there is a common supporting price vector 
\begin_inset Formula $q\gg0$
\end_inset

 and multipliers 
\begin_inset Formula $\mu_{i}>0$
\end_inset

 such that 
\begin_inset Formula $\nabla u_{i}(x^{*}_{i})=\mu_{i}q$
\end_inset

 for every 
\begin_inset Formula $i$
\end_inset

.
 If the behavioral first-order condition is 
\begin_inset Formula $\nabla u_{i}(x^{*}_{i})=\lambda_{i}M_{i}p$
\end_inset

 with 
\begin_inset Formula $\lambda_{i}>0$
\end_inset

,
 then each 
\begin_inset Formula $M_{i}p$
\end_inset

 must be collinear with the same 
\begin_inset Formula $q$
\end_inset

.
\end_layout

\begin_layout Standard
This is a necessary compatibility condition,
 not an if-and-only-if statement about attention matrices.
  Identical matrices can support efficiency in a regular model,
 while different matrices can also be compatible at special allocations.
  Perceived-price optimality alone does not justify either welfare theorem.
\end_layout


